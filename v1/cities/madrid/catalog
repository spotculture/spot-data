os.","people":[],"isFree":true,"priceFrom":null,"imageURL":null,"sourceURL":"http://www.madrid.es/sites/v/index.jsp?vgnextchannel=ca9671ee4a9eb410VgnVCM100000171f5a0aRCRD&vgnextoid=a990640ca9d71a10VgnVCM200000f921e388RCRD","sourceName":"Ayuntamiento de Madrid","isFestival":false,"showtimes":[],"soldOut":null,"fewLeft":null,"reviews":[],"selected":true,"spotNote":null,"artistPick":false,"goodPick":0},{"id":"mad-50470678","title":"El embrujado","category":"theatre","venueID":"v-06f9922e95ac","start":"2026-11-28T18:00:00Z","end":"2026-11-28T22:59:00Z","openingNight":null,"summary":"Companía Aforo Limitado presenta, 'El embrujado' (de Valle Inclán) Escrita por Valle Inclán en 1912 e integrada posteriormente en 1927 dentro de su volumen Retablo de la lujuria, la avaricia y la muerte. Se desarrolla en la Galicia rural, profunda y semi-feudal de la comarca del Salnés, un entorno marcado por la pobreza, las supersticiones, la endogamia y las maldiciones.","people":[],"isFree":true,"priceFrom":null,"imageURL":null,"sourceURL":"http://www.madrid.es/sites/v/index.jsp?vgnextchannel=ca9671ee4a9eb410VgnVCM100000171f5a0aRCRD&vgnextoid=3fbb5e7ea4c81a10VgnVCM100000891ecb1aRCRD","sourceName":"Ayuntamiento de Madrid","isFestival":false,"showtimes":[],"soldOut":null,"fewLeft":null,"reviews":[],"selected":false,"spotNote":null,"artistPick":false,"goodPick":0},{"id":"mad-50317659","title":"Cuadro flamenco con cante y baile: Flamenco en femenino","category":"dance","venueID":"v-ba081ea44bbf","start":"2026-11-28T18:00:00Z","end":"2026-11-28T22:59:00Z","openingNight":null,"summary":"A cargo de la compañía Belén Heredia. Las bailaoras Belén Heredia y Ruth Quesada, con Emilio Gabarre al cante y Jesús Heredia a la guitarra, mostrarán el papel fundamental de la mujer en el flamenco.","people":[],"isFree":true,"priceFrom":null,"imageURL":null,"sourceURL":"http://www.madrid.es/sites/v/index.jsp?vgnextchannel=ca9671ee4a9eb410VgnVCM100000171f5a0aRCRD&vgnextoid=b3350b87e7f4e910VgnVCM200000f921e388RC