amer.jpg","sourceURL":"https://www.lamonnaiedemunt.be/en/program/3932-la-cenerentola","sourceName":"La Monnaie","isFestival":false,"showtimes":[],"soldOut":null,"fewLeft":null,"reviews":[],"selected":true,"spotNote":null,"artistPick":false,"goodPick":0},{"id":"stage-la-monnaie-3933-lucidity","title":"Lucidity","category":"theatre","venueID":"osm-w21758211","start":"2027-01-22T19:00:00Z","end":"2027-01-26T22:00:00Z","openingNight":null,"summary":"‘There is a place in the brain where music lives… time cannot touch it.’","people":[],"isFree":false,"priceFrom":null,"imageURL":"https://d3ew0l5caq1ulf.cloudfront.net/picture/16315/og/lucidity-patrick-leterme-mathilda-du-tillieul-mcnicol.jpg","sourceURL":"https://www.lamonnaiedemunt.be/en/program/3933-lucidity","sourceName":"La Monnaie","isFestival":false,"showtimes":[],"soldOut":null,"fewLeft":null,"reviews":[],"selected":true,"spotNote":null,"artistPick":false,"goodPick":0},{"id":"stage-la-monnaie-3934-ariadne-auf-naxos","title":"Ariadne auf Naxos","category":"theatre","venueID":"osm-w21758211","start":"2027-01-24T14:00:00Z","end":"2027-02-09T21:30:00Z","openingNight":null,"summary":"","people":[],"isFree":false,"priceFrom":null,"imageURL":"https://d3ew0l5caq1ulf.cloudfront.net/picture/16316/og/ariadne-auf-naxos-ariane-matiakh-mariusz-trelinski.jpg","sourceURL":"https://www.lamonnaiedemunt.be/en/program/3934-ariadne-auf-naxos","sourceName":"La Monnaie","isFestival":false,"showtimes":[],"soldOut":null,"fewLeft":null,"reviews":[],"selected":true,"spotNote":null,"artistPick":false,"goodPick":0},{"id":"stage-la-monnaie-3967-gla55","title":"Gla55","category":"theatre","venueID":"osm-w21758211","start":"2027-01-26T19:00:00Z","end":"2027-01-30T20:00:00Z","openingNight":null,"summary":"","people":[],"isFree":false,"priceFrom":null,"imageURL":"https://d3ew0l5caq1ulf.cloudfront.net/picture/16371/og/gla55-anne-teresa-de-keersmaeker-rosas-ictus-blndman.jpg","sourceURL":"https://www.lamonnaiedemunt.be/en/program/3967-gla55","sourceNam