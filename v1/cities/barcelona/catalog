{"city":"barcelona","generatedAt":"2026-11-27T14:23:21Z","attribution":[{"name":"Agenda cultural de Catalunya — Generalitat","url":"https://analisi.transparenciacatalunya.cat/d/rhpv-yr4f","license":"Open data (Generalitat de Catalunya)"},{"name":"Agenda cultural — Ajuntament de Barcelona","url":"https://opendata-ajuntament.barcelona.cat/data/en/dataset/agenda-cultural","license":"CC BY 4.0"},{"name":"Barcelona venues' own websites (MACBA, La Virreina, CCCB, Sala Beckett, Mercat de les Flors, Foto Colectania)","url":"https://www.macba.cat/","license":null},{"name":"Independent cinemas of Barcelona (Verdi, Girona, Zumzeig)","url":"https://barcelona.cines-verdi.com/","license":null},{"name":"OpenStreetMap contributors","url":"https://www.openstreetmap.org/copyright","license":"ODbL"},{"name":"Wikimedia Commons (photos)","url":"https://commons.wikimedia.org","license":"CC BY-SA and others"}],"picks":[],"essentials":[{"id":"macba","name":"MACBA","symbol":"paintpalette","why":{"en":"Contemporary art in Richard Meier's white building, in the Raval.","fr":"L'art contemporain dans le bâtiment blanc de Richard Meier, au Raval.","es":"Arte contemporáneo en el edificio blanco de Richard Meier, en el Raval."},"tip":{"en":"Watch the skaters outside, then see the CCCB next door.","fr":"Regardez les skateurs dehors, puis le CCCB à côté.","es":"Mira a los skaters fuera y visita el CCCB al lado."},"venueID":"v-127b655d3163"},{"id":"miro","name":"Fundació Joan Miró","symbol":"paintpalette","why":{"en":"Miró's own foundation, on Montjuïc, by Josep Lluís Sert.","fr":"La fondation de Miró, sur Montjuïc, signée Josep Lluís Sert.","es":"La fundación de Miró, en Montjuïc, obra de Josep Lluís Sert."},"tip":{"en":"Stay for the view from the roof terraces.","fr":"Restez pour la vue depuis les terrasses.","es":"Quédate por las vistas desde las terrazas."},"venueID":"osm-r3347844"},{"id":"mnac","name":"MNAC","symbol":"building.columns","why":{"en":"Romanesque frescoes saved from Pyrenean churches, and Catalan modernism.","fr":"Fresques romanes sauvées des églises pyrénéennes et modernisme catalan.","es":"Frescos románicos salvados de iglesias pirenaicas y modernismo catalán."},"tip":{"en":"Don't skip the Romanesque rooms.","fr":"Ne manquez pas les salles romanes.","es":"No te pierdas las salas románicas."},"venueID":"osm-w43995751"},{"id":"picasso","name":"Museu Picasso","symbol":"building.columns","why":{"en":"The young Picasso, in medieval palaces of the Born.","fr":"Le jeune Picasso, dans des palais médiévaux du Born.","es":"El joven Picasso, en palacios medievales del Born."},"tip":{"en":"Book a time: it fills up.","fr":"Réservez un créneau : c'est vite plein.","es":"Reserva hora: se llena."},"venueID":"osm-w188938001"},{"id":"tapies","name":"Museu Tàpies","symbol":"paintpalette","why":{"en":"Tàpies's work under the tangled wire sculpture on the roof.","fr":"L'œuvre de Tàpies sous la sculpture de fils emmêlés du toit.","es":"La obra de Tàpies bajo la escultura de alambre del tejado."},"tip":{"en":"Five minutes from Casa Batlló, and far calmer.","fr":"À cinq minutes de la Casa Batlló, et bien plus calme.","es":"A cinco minutos de la Casa Batlló, y mucho más tranquilo."},"venueID":"osm-n1962723905"},{"id":"sagrada","name":"Sagrada Família","symbol":"building.columns","why":{"en":"Gaudí's basilica: the light inside is the reason to go.","fr":"La basilique de Gaudí : la lumière à l'intérieur justifie la visite.","es":"La basílica de Gaudí: la luz del interior es el motivo."},"tip":{"en":"Book ahead, late afternoon for the western light.","fr":"Réservez, en fin d'après-midi pour la lumière.","es":"Reserva, a última hora por la luz de poniente."},"venueID":null},{"id":"pavilion","name":"Barcelona Pavilion","symbol":"building.columns","why":{"en":"Mies van der Rohe's pavilion: small, perfect, in marble and glass.","fr":"Le pavillon de Mies van der Rohe : petit, parfait, en marbre et verre.","es":"El pabellón de Mies van der Rohe: pequeño, perfecto, de mármol y vidrio."},"tip":{"en":"Pair it with CaixaForum, across the road.","fr":"À combiner avec CaixaForum, juste en face.","es":"Combínalo con CaixaForum, justo enfrente."},"venueID":null},{"id":"palau","name":"Palau de la Música Catalana","symbol":"music.note","why":{"en":"Modernist stained glass, best seen during a concert.","fr":"Vitraux modernistes, à voir pendant un concert.","es":"Vidrieras modernistas, mejor durante un concierto."},"tip":{"en":"A concert often costs little more than the tour.","fr":"Un concert coûte souvent à peine plus que la visite.","es":"Un concierto suele costar poco más que la visita."},"venueID":"osm-w377216661"}],"stories":[{"id":"krasner","artist":"Lee Krasner","headline":{"en":"She outlived the myth","fr":"Elle a survécu au mythe","es":"Sobrevivió al mito"},"lines":[{"en":"Born in Brooklyn in 1908, she was already a serious abstract painter when she met Jackson Pollock.","fr":"Née à Brooklyn en 1908, elle était déjà une peintre abstraite reconnue de ses pairs quand elle a rencontré Jackson Pollock.","es":"Nacida en Brooklyn en 1908, ya era una pintora abstracta seria cuando conoció a Jackson Pollock."},{"en":"For years she was seen mostly as his wife. After his death in 1956, she moved into his barn studio.","fr":"Longtemps, on n’a vu en elle que son épouse. Après sa mort en 1956, elle s’installe dans son atelier-grange.","es":"Durante años se la vio sobre todo como su esposa. Tras su muerte en 1956, se instaló en su estudio-granero."},{"en":"There, she painted the biggest, wildest canvases of her life.","fr":"Elle y peint les toiles les plus grandes et les plus libres de sa vie.","es":"Allí pintó los lienzos más grandes y salvajes de su vida."}],"fact":{"en":"In 1953 she tore up her own old drawings and paintings and turned the pieces into new collages.","fr":"En 1953, elle déchire ses propres anciens dessins et tableaux et en fait de nouveaux collages.","es":"En 1953 rompió sus propios dibujos y cuadros antiguos y con los trozos hizo nuevos collages."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Lee_Krasner_2_Broadway_Mural_1959.jpg/1280px-Lee_Krasner_2_Broadway_Mural_1959.jpg","imagePlace":"2 Broadway, New York, 1959"},{"id":"kiefer","artist":"Anselm Kiefer","headline":{"en":"Painting with ash and lead","fr":"Peindre avec la cendre et le plomb","es":"Pintar con ceniza y plomo"},"lines":[{"en":"Born in Germany in 1945, in the last months of the war.","fr":"Né en Allemagne en 1945, dans les derniers mois de la guerre.","es":"Nacido en Alemania en 1945, en los últimos meses de la guerra."},{"en":"While many preferred silence, he made Germany's past his subject.","fr":"Quand beaucoup préféraient le silence, il a fait du passé allemand son sujet.","es":"Cuando muchos preferían el silencio, hizo del pasado alemán su tema."},{"en":"Straw, lead and ash go into his huge canvases: stand close, they feel like scorched earth.","fr":"Paille, plomb et cendre entrent dans ses immenses toiles : de près, on dirait une terre brûlée.","es":"Paja, plomo y ceniza entran en sus enormes lienzos: de cerca parecen tierra quemada."}],"fact":{"en":"In the south of France he turned a former silk factory at Barjac into a 35-hectare artwork of towers, tunnels and crypts.","fr":"Dans le sud de la France, il a transformé une ancienne filature de soie à Barjac en œuvre de 35 hectares : tours, tunnels et cryptes.","es":"En el sur de Francia convirtió una antigua fábrica de seda en Barjac en una obra de 35 hectáreas con torres, túneles y criptas."},"eventID":"cat-2026092100019","imageURL":"https://agenda.cultura.gencat.cat/content/dam/agenda/ca/activitats/2026/09/21/000/19/annexos/anselm-kiefer-app.jpg","imagePlace":null},{"id":"calle","artist":"Sophie Calle","headline":{"en":"She made her life the artwork","fr":"Elle a fait de sa vie une œuvre","es":"Hizo de su vida una obra"},"lines":[{"en":"In Paris, around 1980, she began following strangers and photographing them.","fr":"À Paris, vers 1980, elle se met à suivre des inconnus et à les photographier.","es":"En París, hacia 1980, empezó a seguir a desconocidos y a fotografiarlos."},{"en":"Then she worked as a chambermaid in a Venice hotel, to record what guests left in their rooms.","fr":"Puis elle devient femme de chambre dans un hôtel de Venise, pour consigner ce que laissent les clients.","es":"Después trabajó de camarera de piso en un hotel de Venecia para registrar lo que dejaban los huéspedes."},{"en":"When a man left her by email, she asked 107 women to interpret the message. It went to the 2007 Venice Biennale.","fr":"Quittée par e-mail, elle demande à 107 femmes d’interpréter le message. L’œuvre part à la Biennale de Venise en 2007.","es":"Cuando un hombre la dejó por correo, pidió a 107 mujeres que interpretaran el mensaje. La obra llegó a la Bienal de Venecia de 2007."}],"fact":{"en":"For The Hotel, in 1981, she took a job as a chambermaid in Venice and photographed the guests’ belongings while she cleaned.","fr":"Pour L’Hôtel, en 1981, elle se fait engager comme femme de chambre à Venise et photographie les affaires des clients en faisant le ménage.","es":"Para El hotel, en 1981, trabajó de camarera de piso en Venecia y fotografió las pertenencias de los huéspedes mientras limpiaba."},"eventID":null,"imageURL":"https://imgproxy.berlinonline.net/trS-kOf4VsAYbTZfU6S5bNZLx99HWHKRM5gp5NANSC8/resizing_type:fit/width:1200/height:1200/gravity:ce/enlarge:0/q:70/cb:2026102621/aHR0cHM6Ly9wb3B1bGEtbWlkZGxld2FyZS5zMy5hbWF6b25hd3MuY29tL2JvLW1pZGRsZXdhcmUvYm8uYmRlX2NoYW5uZWwuZXZlbnQvaW1hZ2VzLzY5Lzc2MDZkNjAyLTMyY2EtMjVjOC1mYTQ1LWExMGQxNzA4NDJhZi5qcGc.jpg","imagePlace":"Hamburger Bahnhof - Nationalgalerie der Gegenwart, Berlin"},{"id":"bourgeois","artist":"Louise Bourgeois","headline":{"en":"Famous at seventy","fr":"Célèbre à soixante-dix ans","es":"Famosa a los setenta"},"lines":[{"en":"Born in Paris in 1911, she grew up in a family that restored tapestries.","fr":"Née à Paris en 1911, elle grandit dans une famille de restaurateurs de tapisseries.","es":"Nacida en París en 1911, creció en una familia que restauraba tapices."},{"en":"Her father's affair with her governess marked her forever, and fed her work for decades.","fr":"La liaison de son père avec sa gouvernante la marque à jamais et nourrit son œuvre pendant des décennies.","es":"La aventura de su padre con su institutriz la marcó para siempre y alimentó su obra durante décadas."},{"en":"Wide fame came only with MoMA's 1982 retrospective. Her giant spiders are a portrait of her mother.","fr":"La vraie gloire n’arrive qu’avec la rétrospective du MoMA en 1982. Ses araignées géantes sont un portrait de sa mère.","es":"La fama llegó con la retrospectiva del MoMA en 1982. Sus arañas gigantes son un retrato de su madre."}],"fact":{"en":"Her giant spider, Maman, is a portrait of her mother, who restored tapestries: like a spider, she wove and mended.","fr":"Son araignée géante, Maman, est un portrait de sa mère, restauratrice de tapisseries : comme l’araignée, elle tissait et réparait.","es":"Su araña gigante, Maman, es un retrato de su madre, restauradora de tapices: como la araña, tejía y reparaba."},"eventID":null,"imageURL":"https://cdn.paris.fr/qfapv4/2026/07/21/huge-c596dd37a83e44fb75c80b52f02559f1.jpg","imagePlace":"BnF Richelieu – Galerie Mansart - galerie Pigott, Paris"},{"id":"penn","artist":"Irving Penn","headline":{"en":"A corner, and nothing else","fr":"Un coin de mur, rien d’autre","es":"Un rincón y nada más"},"lines":[{"en":"He spent decades at Vogue, from the 1940s on, making fashion look like sculpture.","fr":"Pendant des décennies à Vogue, dès les années 1940, il fait ressembler la mode à de la sculpture.","es":"Pasó décadas en Vogue, desde los años 40, haciendo que la moda pareciera escultura."},{"en":"He pushed celebrities into a narrow corner of two walls, and watched how they coped.","fr":"Il pousse des célébrités dans l’angle étroit de deux murs et observe comment elles s’en sortent.","es":"Metía a celebridades en el estrecho rincón de dos paredes y observaba cómo reaccionaban."},{"en":"He also photographed cigarette butts as carefully as couture.","fr":"Il a aussi photographié des mégots avec autant de soin que la haute couture.","es":"También fotografió colillas con tanto cuidado como la alta costura."}],"fact":{"en":"In 1948 he squeezed his sitters into a narrow corner made of two walls. Some fought it, some curled up: he said it showed who they were.","fr":"En 1948, il coince ses modèles dans un angle étroit fait de deux murs. Certains résistent, d’autres se recroquevillent : cela révélait qui ils étaient.","es":"En 1948 metía a sus modelos en un rincón estrecho entre dos paredes. Unos se resistían, otros se encogían: decía que eso mostraba quiénes eran."},"eventID":null,"imageURL":"https://static-assets.artlogic.net/w_1200,h_630,c_fill,f_auto,fl_lossy,q_auto:good/ws-ropac/usr/images/exhibitions/main_image_override/items/cb/cb4636ffec3841a0973fa169598a95bc/irp_1305_72dpi.jpg","imagePlace":"Thaddaeus Ropac Marais, Paris"},{"id":"marshall","artist":"Kerry James Marshall","headline":{"en":"Painting Black into the museum","fr":"Faire entrer les corps noirs au musée","es":"Llevar a los cuerpos negros al museo"},"lines":[{"en":"Born in Birmingham, Alabama, in 1955, he grew up in Watts, Los Angeles.","fr":"Né à Birmingham, en Alabama, en 1955, il grandit à Watts, à Los Angeles.","es":"Nacido en Birmingham, Alabama, en 1955, creció en Watts, Los Ángeles."},{"en":"Walking through museums, he saw almost no Black figures in the great paintings.","fr":"Dans les musées, il ne voit presque aucune figure noire dans les grands tableaux.","es":"En los museos apenas veía figuras negras en los grandes cuadros."},{"en":"So he paints them, huge and unmistakably black, in the grand formats of history painting.","fr":"Alors il les peint, immenses et résolument noires, dans les grands formats de la peinture d’histoire.","es":"Así que las pinta, enormes e inequívocamente negras, en los grandes formatos de la pintura de historia."}],"fact":{"en":"He mixes his figures’ black from three different blacks, so there is no mistaking it: black, not shadow.","fr":"Il compose le noir de ses personnages à partir de trois noirs différents, pour qu’on ne s’y trompe pas : du noir, pas de l’ombre.","es":"Mezcla el negro de sus figuras con tres negros distintos, para que no haya duda: negro, no sombra."},"eventID":null,"imageURL":"https://www.parismusees.paris.fr/sites/default/files/2026-05/Kerry%20James%20Marshall.%20The%20Histories.png","imagePlace":"Musée d'Art Moderne de Paris, Paris"},{"id":"cassatt","artist":"Mary Cassatt","headline":{"en":"The American among the Impressionists","fr":"L’Américaine chez les impressionnistes","es":"La estadounidense entre los impresionistas"},"lines":[{"en":"Born in Pennsylvania in 1844, she moved to Paris against her father's wishes.","fr":"Née en Pennsylvanie en 1844, elle s’installe à Paris contre l’avis de son père.","es":"Nacida en Pensilvania en 1844, se mudó a París contra la voluntad de su padre."},{"en":"Degas invited her to show with the Impressionists: she was the only American among them.","fr":"Degas l’invite à exposer avec les impressionnistes : elle est la seule Américaine du groupe.","es":"Degas la invitó a exponer con los impresionistas: fue la única estadounidense entre ellos."},{"en":"She painted women's real lives: reading, at the opera, caring for children.","fr":"Elle peint la vraie vie des femmes : lire, aller à l’opéra, s’occuper des enfants.","es":"Pintó la vida real de las mujeres: leyendo, en la ópera, cuidando de los niños."}],"fact":{"en":"She steered rich American friends, above all the Havemeyers, to buy Impressionist paintings. Many of them are now at the Met.","fr":"Elle a guidé ses riches amis américains, surtout les Havemeyer, vers l’achat de tableaux impressionnistes. Beaucoup sont aujourd’hui au Met.","es":"Guió a sus amigos estadounidenses ricos, sobre todo a los Havemeyer, a comprar cuadros impresionistas. Muchos están hoy en el Met."},"eventID":null,"imageURL":"https://cdn.paris.fr/qfapv4/2026/08/24/huge-0066fdb5b77c183fab979b53a0857b04.jpg","imagePlace":"Musée d'Orsay, Paris"},{"id":"neshat","artist":"Shirin Neshat","headline":{"en":"Words written on skin","fr":"Des mots écrits sur la peau","es":"Palabras escritas en la piel"},"lines":[{"en":"Born in Iran in 1957, she left for the United States as a teenager to study art.","fr":"Née en Iran en 1957, elle part adolescente étudier l’art aux États-Unis.","es":"Nacida en Irán en 1957, se fue de adolescente a estudiar arte a Estados Unidos."},{"en":"Back on a visit years later, she barely recognised the country after the Revolution.","fr":"De retour des années plus tard, elle reconnaît à peine son pays après la Révolution.","es":"Al volver años después, apenas reconoció su país tras la Revolución."},{"en":"Her Women of Allah photographs cover faces and hands in Persian poetry.","fr":"Ses photographies Women of Allah couvrent visages et mains de poésie persane.","es":"Sus fotografías Women of Allah cubren rostros y manos con poesía persa."}],"fact":{"en":"In Women of Allah, the Persian calligraphy covering faces and hands was written by hand directly onto the photographs.","fr":"Dans Women of Allah, la calligraphie persane qui couvre visages et mains a été écrite à la main directement sur les photos.","es":"En Women of Allah, la caligrafía persa que cubre rostros y manos se escribió a mano directamente sobre las fotos."},"eventID":null,"imageURL":"https://www.maxxi.art/wp-content/uploads/2026/10/shirinneshatdoudare.jpg","imagePlace":"MAXXI Museo nazionale delle arti del XXI secolo, Rome"},{"id":"soulages","artist":"Pierre Soulages","headline":{"en":"The painter of black light","fr":"Le peintre de la lumière noire","es":"El pintor de la luz negra"},"lines":[{"en":"Born in Rodez in 1919, he painted until he was over a hundred.","fr":"Né à Rodez en 1919, il a peint jusqu’à plus de cent ans.","es":"Nacido en Rodez en 1919, pintó hasta pasados los cien años."},{"en":"In 1979, working on a canvas that was going badly, he saw that the light on the black was the real subject.","fr":"En 1979, sur une toile qui tourne mal, il comprend que la lumière sur le noir est le vrai sujet.","es":"En 1979, con un lienzo que iba mal, vio que la luz sobre el negro era el verdadero tema."},{"en":"He called it outrenoir, beyond black. Walk past one: it changes as you move.","fr":"Il l’appelle outrenoir. Passez devant : le tableau change à chaque pas.","es":"Lo llamó outrenoir, más allá del negro. Pasa por delante: cambia a cada paso."}],"fact":{"en":"As a boy he drew thick black lines on white paper. When asked what it was, he said: snow.","fr":"Enfant, il trace d’épaisses lignes noires sur du papier blanc. Quand on lui demande ce que c’est, il répond : de la neige.","es":"De niño trazaba gruesas líneas negras en papel blanco. Cuando le preguntaban qué era, respondía: nieve."},"eventID":null,"imageURL":"https://static-assets.artlogic.net/w_1200,h_630,c_fill,f_auto,fl_lossy/ws-timothytaylor/usr/images/exhibitions/main_image_override/266/t0013133_300dpi-copy-2.jpg","imagePlace":"Timothy Taylor, London"},{"id":"avedon","artist":"Richard Avedon","headline":{"en":"From couture to the American West","fr":"De la couture à l’Ouest américain","es":"De la alta costura al Oeste americano"},"lines":[{"en":"Born in New York in 1923, he became the fashion photographer of his age, at Harper's Bazaar.","fr":"Né à New York en 1923, il devient le photographe de mode de son époque, chez Harper’s Bazaar.","es":"Nacido en Nueva York en 1923, fue el fotógrafo de moda de su época, en Harper’s Bazaar."},{"en":"From 1979 to 1984 he crossed the West, photographing drifters, miners and slaughterhouse workers.","fr":"De 1979 à 1984, il sillonne l’Ouest et photographie vagabonds, mineurs et ouvriers d’abattoirs.","es":"De 1979 a 1984 recorrió el Oeste fotografiando vagabundos, mineros y trabajadores de mataderos."},{"en":"Against plain white, life size, with the same attention he gave to stars.","fr":"Sur fond blanc, grandeur nature, avec la même attention qu’il accordait aux stars.","es":"Sobre fondo blanco, a tamaño real, con la misma atención que daba a las estrellas."}],"fact":{"en":"Fred Astaire’s fashion photographer in the film Funny Face, in 1957, was based on him, and he worked on the film.","fr":"Le photographe de mode joué par Fred Astaire dans Drôle de frimousse, en 1957, est inspiré de lui, et il a travaillé sur le film.","es":"El fotógrafo de moda que interpreta Fred Astaire en Una cara con ángel, de 1957, está inspirado en él, y trabajó en la película."},"eventID":null,"imageURL":"https://www.palazzoesposizioniroma.it:443/ogimages/c1f45c20-f4a5-4277-b653-82fb1b4ad678x39026791.png","imagePlace":"Palazzo delle Esposizioni, Rome"},{"id":"joan-mitchell","artist":"Joan Mitchell","headline":{"en":"Painting what she remembered","fr":"Peindre ce dont on se souvient","es":"Pintar lo que recordaba"},"lines":[{"en":"Born in Chicago in 1925, she moved to France for good in 1959.","fr":"Née à Chicago en 1925, elle s’installe définitivement en France en 1959.","es":"Nacida en Chicago en 1925, se instaló en Francia para siempre en 1959."},{"en":"From 1968 she lived in Vétheuil, the village where Monet once lived.","fr":"Dès 1968, elle vit à Vétheuil, le village où Monet a vécu.","es":"Desde 1968 vivió en Vétheuil, el pueblo donde vivió Monet."},{"en":"She said she painted the memory of landscapes, not the landscapes.","fr":"Elle disait peindre le souvenir de paysages, pas les paysages.","es":"Decía pintar el recuerdo de los paisajes, no los paisajes."}],"fact":{"en":"From 1968 she lived at Vétheuil, in a house above the river Monet had painted from his own house there, just below.","fr":"À partir de 1968, elle vit à Vétheuil, au-dessus de la Seine que Monet avait peinte depuis sa maison, juste en contrebas.","es":"Desde 1968 vivió en Vétheuil, sobre el río que Monet había pintado desde su casa, justo debajo."},"eventID":null,"imageURL":"https://upload.wikimedia.org/wikipedia/commons/a/af/Joan_Mitchell.jpg","imagePlace":"Wikimedia Commons"},{"id":"pollock","artist":"Jackson Pollock","headline":{"en":"The canvas on the floor","fr":"La toile au sol","es":"El lienzo en el suelo"},"lines":[{"en":"Born in Wyoming in 1912, he moved to Long Island in 1945.","fr":"Né dans le Wyoming en 1912, il s’installe à Long Island en 1945.","es":"Nacido en Wyoming en 1912, se mudó a Long Island en 1945."},{"en":"In the barn he laid his canvas flat and poured paint from above.","fr":"Dans la grange, il pose la toile à plat et verse la peinture d’en haut.","es":"En el granero extendía el lienzo y vertía la pintura desde arriba."},{"en":"Lee Krasner, his wife, kept his work alive after his death in a car crash in 1956.","fr":"Lee Krasner, sa femme, fait vivre son œuvre après sa mort en voiture en 1956.","es":"Lee Krasner, su esposa, mantuvo viva su obra tras su muerte en coche en 1956."}],"fact":{"en":"In 1949 Life magazine asked: “Is he the greatest living painter in the United States?” Time later called him Jack the Dripper.","fr":"En 1949, le magazine Life demande : « Est-il le plus grand peintre vivant des États-Unis ? » Time le surnommera Jack the Dripper.","es":"En 1949 la revista Life preguntó: «¿Es el mayor pintor vivo de Estados Unidos?». Time lo apodó después Jack the Dripper."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Jackson_Pollock_by_Hans_Namuth.jpg/960px-Jackson_Pollock_by_Hans_Namuth.jpg","imagePlace":"Wikimedia Commons"},{"id":"rothko","artist":"Mark Rothko","headline":{"en":"He gave the money back","fr":"Il a rendu l’argent","es":"Devolvió el dinero"},"lines":[{"en":"Born in present-day Latvia in 1903, he reached America aged ten.","fr":"Né en 1903 dans l’actuelle Lettonie, il arrive en Amérique à dix ans.","es":"Nacido en 1903 en la actual Letonia, llegó a América a los diez años."},{"en":"Commissioned to paint for a grand New York restaurant, he went to dine there, and withdrew.","fr":"Chargé de peindre pour un grand restaurant new-yorkais, il y dîne, puis renonce.","es":"Le encargaron pinturas para un gran restaurante de Nueva York; fue a cenar y renunció."},{"en":"He wanted you close to the canvas, inside the colour.","fr":"Il vous voulait tout près de la toile, dans la couleur.","es":"Te quería cerca del lienzo, dentro del color."}],"fact":{"en":"He painted murals for the Four Seasons restaurant in New York, then gave the money back: he didn’t want rich diners eating under them.","fr":"Il peint des toiles pour le restaurant Four Seasons à New York, puis rend l’argent : il ne veut pas que des riches dînent dessous.","es":"Pintó murales para el restaurante Four Seasons de Nueva York y luego devolvió el dinero: no quería que los ricos cenaran bajo ellos."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ea/Consuelo_Kanaga%2C_Mark_Rothko%2C_Yorktown_Heights%2C_ca._1949.jpg/960px-Consuelo_Kanaga%2C_Mark_Rothko%2C_Yorktown_Heights%2C_ca._1949.jpg","imagePlace":"Wikimedia Commons"},{"id":"frankenthaler","artist":"Helen Frankenthaler","headline":{"en":"Paint poured like water","fr":"La peinture comme de l’eau","es":"Pintura como agua"},"lines":[{"en":"At 23, in 1952, she thinned her paint and poured it onto raw canvas.","fr":"À 23 ans, en 1952, elle dilue sa peinture et la verse sur une toile brute.","es":"A los 23 años, en 1952, diluyó la pintura y la vertió sobre lienzo crudo."},{"en":"Colour no longer sat on the surface: it soaked into the cloth.","fr":"La couleur ne reste plus en surface : elle imprègne le tissu.","es":"El color ya no quedaba en la superficie: empapaba la tela."},{"en":"Painters who saw the work went home and changed how they painted.","fr":"Des peintres venus la voir rentrent changer leur façon de peindre.","es":"Pintores que vieron la obra cambiaron su forma de pintar."}],"fact":{"en":"In 1953 Morris Louis and Kenneth Noland visited her studio, saw Mountains and Sea, and went home to try her soak-stain method.","fr":"En 1953, Morris Louis et Kenneth Noland visitent son atelier, voient Mountains and Sea et rentrent essayer sa technique de la toile imbibée.","es":"En 1953 Morris Louis y Kenneth Noland visitaron su estudio, vieron Mountains and Sea y volvieron a casa a probar su técnica de empapar el lienzo."},"eventID":null,"imageURL":"https://upload.wikimedia.org/wikipedia/commons/1/14/2001_National_Medal_of_Arts_Recipient_Helen_Frankenthaler_%28cropped%29.jpg","imagePlace":"Wikimedia Commons"},{"id":"af-klint","artist":"Hilma af Klint","headline":{"en":"Paintings for the future","fr":"Des tableaux pour l’avenir","es":"Cuadros para el futuro"},"lines":[{"en":"Born in Stockholm in 1862, she was a respected painter of landscapes.","fr":"Née à Stockholm en 1862, elle est une paysagiste reconnue.","es":"Nacida en Estocolmo en 1862, fue una paisajista respetada."},{"en":"From 1906 she made huge abstract works, before Kandinsky.","fr":"Dès 1906, elle peint d’immenses toiles abstraites, avant Kandinsky.","es":"Desde 1906 pintó enormes obras abstractas, antes que Kandinsky."},{"en":"She asked that they stay hidden for 20 years after her death.","fr":"Elle demande qu’elles restent cachées 20 ans après sa mort.","es":"Pidió que siguieran ocultas 20 años tras su muerte."}],"fact":{"en":"With four other women she formed The Five, who held séances and made automatic drawings, years before her abstract paintings.","fr":"Avec quatre autres femmes, elle forme Les Cinq, qui tiennent des séances de spiritisme et font des dessins automatiques, des années avant ses toiles abstraites.","es":"Con otras cuatro mujeres formó Las Cinco, que celebraban sesiones espiritistas y hacían dibujos automáticos, años antes de sus cuadros abstractos."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Hilma-af-Klint-uncropped.jpg/960px-Hilma-af-Klint-uncropped.jpg","imagePlace":"Wikimedia Commons"},{"id":"bausch","artist":"Pina Bausch","headline":{"en":"Dance, with eyes closed","fr":"Danser les yeux fermés","es":"Bailar con los ojos cerrados"},"lines":[{"en":"Born in Solingen in 1940, she took over the Wuppertal company in 1973.","fr":"Née à Solingen en 1940, elle prend la troupe de Wuppertal en 1973.","es":"Nacida en Solingen en 1940, asumió la compañía de Wuppertal en 1973."},{"en":"She asked dancers about their lives, and built shows from their answers.","fr":"Elle interroge ses danseurs sur leur vie et bâtit ses pièces sur leurs réponses.","es":"Preguntaba a sus bailarines por sus vidas y creaba con sus respuestas."},{"en":"Café Müller opens Almodóvar's film Talk to Her.","fr":"Café Müller ouvre le film d’Almodóvar Parle avec elle.","es":"Café Müller abre la película de Almodóvar Hable con ella."}],"fact":{"en":"She restaged her piece Kontakthof with dancers over 65, then with teenagers who had never danced on stage.","fr":"Elle a remonté sa pièce Kontakthof avec des danseurs de plus de 65 ans, puis avec des adolescents qui n’étaient jamais montés sur scène.","es":"Volvió a montar Kontakthof con bailarines de más de 65 años y luego con adolescentes que nunca habían pisado un escenario."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4b/Pina_Bausch_%28festival_d%27Avignon%2C_1981%29.jpg/960px-Pina_Bausch_%28festival_d%27Avignon%2C_1981%29.jpg","imagePlace":"Wikimedia Commons"},{"id":"goldin","artist":"Nan Goldin","headline":{"en":"A diary, in slides","fr":"Un journal en diapositives","es":"Un diario en diapositivas"},"lines":[{"en":"Born in Washington in 1953, she was marked by her sister's suicide.","fr":"Née à Washington en 1953, elle est marquée par le suicide de sa sœur.","es":"Nacida en Washington en 1953, la marcó el suicidio de su hermana."},{"en":"The Ballad of Sexual Dependency began as a slide show in New York clubs.","fr":"The Ballad of Sexual Dependency commence en diaporama dans les clubs new-yorkais.","es":"The Ballad of Sexual Dependency nació como proyección en clubes de Nueva York."},{"en":"Later she took on the Sackler family inside the museums that bore their name.","fr":"Plus tard, elle s’attaque aux Sackler dans les musées portant leur nom.","es":"Después se enfrentó a los Sackler en los museos que llevaban su nombre."}],"fact":{"en":"The Ballad of Sexual Dependency began as slide shows in New York clubs and bars in the late 1970s, with a soundtrack played live.","fr":"La Ballade de la dépendance sexuelle a commencé comme des projections de diapositives dans les clubs et bars de New York à la fin des années 1970, avec la musique en direct.","es":"La balada de la dependencia sexual empezó como proyecciones de diapositivas en clubes y bares de Nueva York a finales de los setenta, con música en directo."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Nan_Goldin_2.jpg/960px-Nan_Goldin_2.jpg","imagePlace":"team art in berlin, CC BY-SA 2.0, Wikimedia Commons"},{"id":"richter","artist":"Gerhard Richter","headline":{"en":"From a photo to a blur","fr":"De la photo au flou","es":"De la foto al desenfoque"},"lines":[{"en":"Born in Dresden in 1932, he left East Germany in 1961, just before the Wall.","fr":"Né à Dresde en 1932, il quitte la RDA en 1961, juste avant le Mur.","es":"Nacido en Dresde en 1932, dejó la RDA en 1961, justo antes del Muro."},{"en":"He painted from snapshots and newspapers, then dragged the paint to blur them.","fr":"Il peint d’après des clichés et des journaux, puis les brouille.","es":"Pintaba a partir de fotos y periódicos, y luego los difuminaba."},{"en":"His abstracts are pulled across the canvas with a huge squeegee.","fr":"Ses abstraits sont tirés sur la toile avec une immense raclette.","es":"Sus abstractos se arrastran por el lienzo con una enorme rasqueta."}],"fact":{"en":"His window for Cologne Cathedral, in 2007, is 11,263 squares of glass in 72 colours, many placed by chance.","fr":"Son vitrail pour la cathédrale de Cologne, en 2007, compte 11 263 carrés de verre de 72 couleurs, beaucoup placés au hasard.","es":"Su vidriera para la catedral de Colonia, de 2007, tiene 11.263 cuadrados de vidrio en 72 colores, muchos colocados al azar."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Gerhard_Richter%2C_Prague_%282017%29.jpg/960px-Gerhard_Richter%2C_Prague_%282017%29.jpg","imagePlace":"Jindřich Nosek (NoJin), CC BY-SA 4.0, Wikimedia Commons"},{"id":"gentileschi","artist":"Artemisia Gentileschi","headline":{"en":"She painted her own justice","fr":"Sa propre justice","es":"Su propia justicia"},"lines":[{"en":"Born in Rome in 1593, she learned to paint in her father's workshop.","fr":"Née à Rome en 1593, elle apprend dans l’atelier de son père.","es":"Nacida en Roma en 1593, aprendió en el taller de su padre."},{"en":"In 1612 she faced the man who raped her in a public trial.","fr":"En 1612, elle affronte son violeur lors d’un procès public.","es":"En 1612 se enfrentó a su violador en un juicio público."},{"en":"In 1616 she became the first woman in Florence's Academy.","fr":"En 1616, elle est la première femme de l’Académie de Florence.","es":"En 1616 fue la primera mujer de la Academia de Florencia."}],"fact":{"en":"In a letter to a patron in 1649 she wrote: “You will find the spirit of Caesar in the soul of a woman.”","fr":"Dans une lettre à un mécène en 1649, elle écrit : « Vous trouverez l’esprit de César dans l’âme d’une femme. »","es":"En una carta a un mecenas en 1649 escribió: «Encontrará el espíritu de César en el alma de una mujer»."},"eventID":null,"imageURL":"https://upload.wikimedia.org/wikipedia/commons/3/32/Artemisia_Gentileschi_Selfportrait_Martyr.jpg","imagePlace":"Wikimedia Commons"},{"id":"monet","artist":"Claude Monet","headline":{"en":"A garden for the nation","fr":"Un jardin pour la nation","es":"Un jardín para la nación"},"lines":[{"en":"At Giverny he dug a pond so that he could paint it.","fr":"À Giverny, il creuse un bassin pour pouvoir le peindre.","es":"En Giverny excavó un estanque para poder pintarlo."},{"en":"He went on painting his Water Lilies with failing eyes.","fr":"Il continue ses Nymphéas alors que sa vue baisse.","es":"Siguió pintando sus Nenúfares mientras perdía la vista."},{"en":"He gave them to France the day after the 1918 Armistice.","fr":"Il les offre à la France au lendemain de l’Armistice de 1918.","es":"Los ofreció a Francia el día después del Armisticio de 1918."}],"fact":{"en":"To make his water garden at Giverny, he had a branch of the river diverted, despite local farmers fearing he would poison their water.","fr":"Pour créer son jardin d’eau à Giverny, il fait dériver un bras de rivière, malgré les paysans qui craignaient qu’il empoisonne leur eau.","es":"Para crear su jardín acuático en Giverny desvió un brazo del río, pese a los campesinos que temían que les envenenara el agua."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a4/Claude_Monet_1899_Nadar_crop.jpg/960px-Claude_Monet_1899_Nadar_crop.jpg","imagePlace":"Wikimedia Commons"},{"id":"kahlo","artist":"Frida Kahlo","headline":{"en":"She painted from her bed","fr":"Elle peignait depuis son lit","es":"Pintaba desde la cama"},"lines":[{"en":"At 18, in 1925, a tram crashed into her bus in Mexico City. She was in pain for the rest of her life.","fr":"À 18 ans, en 1925, un tramway percute son bus à Mexico. Elle souffrira toute sa vie.","es":"A los 18 años, en 1925, un tranvía embistió su autobús en Ciudad de México. Sufrió dolores toda su vida."},{"en":"Stuck in bed for months, she began to paint, with a mirror fixed above her.","fr":"Clouée au lit pendant des mois, elle se met à peindre, un miroir fixé au-dessus d’elle.","es":"Postrada durante meses, empezó a pintar con un espejo colgado encima de ella."},{"en":"She became her own subject: about a third of her paintings are self-portraits.","fr":"Elle devient son propre sujet : environ un tiers de ses tableaux sont des autoportraits.","es":"Se convirtió en su propio tema: cerca de un tercio de sus cuadros son autorretratos."}],"fact":{"en":"At her only solo show in Mexico, in 1953, she was too ill to walk. She arrived by ambulance and received guests from her four-poster bed, carried into the gallery.","fr":"Pour sa seule exposition personnelle au Mexique, en 1953, elle ne peut plus marcher. Elle arrive en ambulance et reçoit ses invités dans son lit à baldaquin, installé dans la galerie.","es":"En su única exposición individual en México, en 1953, ya no podía caminar. Llegó en ambulancia y recibió a los invitados desde su cama con dosel, trasladada a la galería."},"eventID":null,"imageURL":"https://upload.wikimedia.org/wikipedia/commons/6/6c/Tate_Modern_viewed_from_Thames_Pleasure_Boat_-_geograph.org.uk_-_307445.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","imagePlace":"Tate Modern, London"},{"id":"mendieta","artist":"Ana Mendieta","headline":{"en":"Her body, drawn in the earth","fr":"Son corps, tracé dans la terre","es":"Su cuerpo, dibujado en la tierra"},"lines":[{"en":"Born in Havana in 1948, she was sent to the United States with her sister at 12.","fr":"Née à La Havane en 1948, elle est envoyée aux États-Unis avec sa sœur à 12 ans.","es":"Nacida en La Habana en 1948, la enviaron a Estados Unidos con su hermana a los 12 años."},{"en":"In her Siluetas, she pressed the outline of her body into mud, sand, grass, flowers and fire.","fr":"Dans ses Siluetas, elle imprime la forme de son corps dans la boue, le sable, l’herbe, les fleurs, le feu.","es":"En sus Siluetas imprimía la silueta de su cuerpo en barro, arena, hierba, flores y fuego."},{"en":"The rain and the tide took them away. Only her photographs and films remain.","fr":"La pluie et la marée les ont effacées. Il n’en reste que ses photos et ses films.","es":"La lluvia y la marea se las llevaron. Solo quedan sus fotos y sus películas."}],"fact":{"en":"Her first Silueta, in 1973, was made in an ancient Zapotec tomb at Yagul, in Mexico: she lay in it naked, covered in white flowers.","fr":"Sa première Silueta, en 1973, est faite dans une tombe zapotèque antique à Yagul, au Mexique : elle s’y allonge nue, couverte de fleurs blanches.","es":"Su primera Silueta, en 1973, la hizo en una antigua tumba zapoteca en Yagul, México: se tumbó desnuda, cubierta de flores blancas."},"eventID":null,"imageURL":"https://upload.wikimedia.org/wikipedia/commons/6/6c/Tate_Modern_viewed_from_Thames_Pleasure_Boat_-_geograph.org.uk_-_307445.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","imagePlace":"Tate Modern, London"},{"id":"le-parc","artist":"Julio Le Parc","headline":{"en":"He let a coin decide","fr":"Il a laissé une pièce décider","es":"Dejó que decidiera una moneda"},"lines":[{"en":"He left Argentina for Paris in 1958 and made art from light, mirrors and movement.","fr":"Il quitte l’Argentine pour Paris en 1958 et fait de l’art avec la lumière, les miroirs et le mouvement.","es":"Dejó Argentina por París en 1958 e hizo arte con luz, espejos y movimiento."},{"en":"He wanted visitors to play, push, wobble and get lost, not just look.","fr":"Il veut que le public joue, pousse, vacille et se perde, pas seulement qu’il regarde.","es":"Quería que el público jugara, empujara, se tambaleara y se perdiera, no solo que mirara."},{"en":"In 1966 he won the painting prize at the Venice Biennale, without making paintings in the usual sense.","fr":"En 1966, il remporte le grand prix de peinture de la Biennale de Venise, sans peindre au sens habituel.","es":"En 1966 ganó el premio de pintura de la Bienal de Venecia, sin pintar en el sentido habitual."}],"fact":{"en":"Offered a retrospective at the Musée d’Art Moderne de Paris in 1972, he tossed a coin to decide. It came up no, and he turned it down.","fr":"Quand le Musée d’Art moderne de Paris lui propose une rétrospective en 1972, il tire à pile ou face. C’est non : il refuse.","es":"Cuando el Museo de Arte Moderno de París le ofreció una retrospectiva en 1972, lo echó a cara o cruz. Salió que no, y la rechazó."},"eventID":null,"imageURL":"https://upload.wikimedia.org/wikipedia/commons/6/6c/Tate_Modern_viewed_from_Thames_Pleasure_Boat_-_geograph.org.uk_-_307445.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","imagePlace":"Tate Modern, London"},{"id":"vanessa-bell","artist":"Vanessa Bell","headline":{"en":"She painted the whole house","fr":"Elle a peint toute la maison","es":"Pintó toda la casa"},"lines":[{"en":"Virginia Woolf’s older sister, she was a painter at the heart of the Bloomsbury group.","fr":"Sœur aînée de Virginia Woolf, elle est peintre au cœur du groupe de Bloomsbury.","es":"Hermana mayor de Virginia Woolf, fue pintora en el centro del grupo de Bloomsbury."},{"en":"In 1916 she moved to Charleston, a farmhouse in Sussex, with the painter Duncan Grant.","fr":"En 1916, elle s’installe à Charleston, une ferme du Sussex, avec le peintre Duncan Grant.","es":"En 1916 se mudó a Charleston, una granja de Sussex, con el pintor Duncan Grant."},{"en":"Together they covered doors, walls, tables and fireplaces with paint. It is still there.","fr":"Ensemble, ils peignent portes, murs, tables et cheminées. Tout y est encore.","es":"Juntos pintaron puertas, paredes, mesas y chimeneas. Todo sigue allí."}],"fact":{"en":"In 1913 she co-founded the Omega Workshops with Roger Fry: furniture, fabrics and pottery made by artists, never signed, marked only with the Greek letter Ω.","fr":"En 1913, elle cofonde les Omega Workshops avec Roger Fry : meubles, tissus et céramiques faits par des artistes, jamais signés, marqués seulement de la lettre Ω.","es":"En 1913 cofundó los Omega Workshops con Roger Fry: muebles, telas y cerámica hechos por artistas, nunca firmados, marcados solo con la letra Ω."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Tate_Britain%2C_Millbank_-_panoramio_%281%29.jpg/960px-Tate_Britain%2C_Millbank_-_panoramio_%281%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"Tate Britain, London"},{"id":"yoko-ono","artist":"Yoko Ono","headline":{"en":"Art as an instruction","fr":"L’art comme une consigne","es":"El arte como instrucción"},"lines":[{"en":"In Cut Piece, in 1964, she sat still on a stage and let the audience cut away her clothes.","fr":"Dans Cut Piece, en 1964, elle reste assise sur scène et laisse le public découper ses vêtements.","es":"En Cut Piece, en 1964, se sentó inmóvil en un escenario y dejó que el público le cortara la ropa."},{"en":"Her book Grapefruit is made of instructions: “Listen to the sound of the earth turning.”","fr":"Son livre Grapefruit n’est fait que de consignes : « Écoutez le bruit de la Terre qui tourne. »","es":"Su libro Grapefruit está hecho de instrucciones: «Escucha el sonido de la Tierra girando»."},{"en":"The artwork is the idea; whoever follows it finishes the piece.","fr":"L’œuvre, c’est l’idée ; celui qui la suit la termine.","es":"La obra es la idea; quien la sigue la termina."}],"fact":{"en":"In 1971 she advertised a solo show at MoMA that the museum knew nothing about. It was a hoax: she said she had released flies in the museum, and visitors were asked to trace them.","fr":"En 1971, elle annonce une exposition au MoMA dont le musée ne sait rien. Un canular : elle prétend y avoir lâché des mouches, à suivre par les visiteurs.","es":"En 1971 anunció una exposición en el MoMA de la que el museo no sabía nada. Era una broma: decía haber soltado moscas en el museo para que el público las siguiera."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/MoMa_NY_USA_1.jpg/960px-MoMa_NY_USA_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"MoMA, New York"},{"id":"lichtenstein","artist":"Roy Lichtenstein","headline":{"en":"A dare from his son","fr":"Un défi de son fils","es":"Un reto de su hijo"},"lines":[{"en":"In 1961, the story goes, one of his sons pointed at a Mickey Mouse comic and said he couldn’t paint that well.","fr":"En 1961, raconte-t-on, un de ses fils lui montre une BD de Mickey en le mettant au défi de peindre aussi bien.","es":"En 1961, según se cuenta, uno de sus hijos le señaló un cómic de Mickey y le dijo que no sabría pintar así."},{"en":"He painted Look Mickey, and turned to cheap comics and adverts.","fr":"Il peint Look Mickey, et se tourne vers les comics et la publicité bon marché.","es":"Pintó Look Mickey y se volcó en los cómics y la publicidad barata."},{"en":"He painted by hand the dots that printers made by machine.","fr":"Il peint à la main les points que les imprimeurs faisaient à la machine.","es":"Pintaba a mano los puntos que las imprentas hacían a máquina."}],"fact":{"en":"The dots have a name: Ben-Day dots, after the printer Benjamin Day, who invented the process in 1879 to shade cheap printing.","fr":"Ces points ont un nom : les points Ben-Day, du nom de l’imprimeur Benjamin Day, qui les invente en 1879 pour ombrer l’impression bon marché.","es":"Esos puntos tienen nombre: puntos Ben-Day, por el impresor Benjamin Day, que los inventó en 1879 para sombrear la impresión barata."},"eventID":null,"imageURL":"https://whitneymedia.org/assets/image/833779/WMAA20998_2019_79_cropped_web.jpg","imagePlace":"Whitney Museum of American Art, New York"},{"id":"marden","artist":"Brice Marden","headline":{"en":"From wax to brushstrokes","fr":"De la cire au trait","es":"De la cera al trazo"},"lines":[{"en":"In the 1960s he painted single colours mixed with beeswax, matt and dense as skin.","fr":"Dans les années 1960, il peint des aplats de couleur mêlée de cire d’abeille, mats et denses comme une peau.","es":"En los años sesenta pintaba colores planos mezclados con cera de abeja, mates y densos como la piel."},{"en":"Then Chinese calligraphy and the poems of Cold Mountain set his line free.","fr":"Puis la calligraphie chinoise et les poèmes de Montagne froide libèrent son trait.","es":"Luego la caligrafía china y los poemas de Montaña Fría liberaron su trazo."},{"en":"He painted those looping lines with long sticks, standing back from the canvas.","fr":"Il peint ces lignes en boucle avec de longues baguettes, à distance de la toile.","es":"Pintaba esas líneas enroscadas con palos largos, a distancia del lienzo."}],"fact":{"en":"Before he was famous he worked as a museum guard at the Jewish Museum, then as Robert Rauschenberg’s assistant.","fr":"Avant d’être connu, il a été gardien au Jewish Museum de New York, puis assistant de Robert Rauschenberg.","es":"Antes de ser famoso trabajó como vigilante en el Jewish Museum de Nueva York y luego como asistente de Robert Rauschenberg."},"eventID":null,"imageURL":"https://upload.wikimedia.org/wikipedia/commons/2/22/The_West_24th_Street_Gallery%2C_Gagosian_Gallery_Nov_26%2C_2019.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","imagePlace":"Gagosian, New York"},{"id":"brancusi","artist":"Constantin Brancusi","headline":{"en":"The bird that went to court","fr":"L’oiseau qui alla au tribunal","es":"El pájaro que fue a juicio"},"lines":[{"en":"He came to Paris from Romania in 1904, much of the way on foot.","fr":"Il arrive de Roumanie à Paris en 1904, en grande partie à pied.","es":"Llegó de Rumanía a París en 1904, buena parte del camino a pie."},{"en":"He left Rodin’s workshop after a few weeks: “Nothing grows in the shade of big trees.”","fr":"Il quitte l’atelier de Rodin au bout de quelques semaines : « Rien ne pousse à l’ombre des grands arbres. »","es":"Dejó el taller de Rodin a las pocas semanas: «Nada crece a la sombra de los grandes árboles»."},{"en":"He cut sculpture down to its essence: an egg, a kiss, a bird in flight.","fr":"Il réduit la sculpture à l’essentiel : un œuf, un baiser, un oiseau qui s’envole.","es":"Redujo la escultura a lo esencial: un huevo, un beso, un pájaro que vuela."}],"fact":{"en":"In 1926 US customs refused to see his Bird in Space as art and taxed it as a piece of metal. A court ruled in 1928 that it was a work of art.","fr":"En 1926, la douane américaine refuse d’y voir de l’art et taxe son Oiseau dans l’espace comme un objet en métal. Un tribunal tranche en 1928 : c’est une œuvre d’art.","es":"En 1926 la aduana de EE. UU. se negó a ver arte en su Pájaro en el espacio y lo gravó como objeto de metal. En 1928 un tribunal dictó que era una obra de arte."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/MoMa_NY_USA_1.jpg/960px-MoMa_NY_USA_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"MoMA, New York"},{"id":"huyghe","artist":"Pierre Huyghe","headline":{"en":"Exhibitions that live on their own","fr":"Des expositions qui vivent seules","es":"Exposiciones que viven solas"},"lines":[{"en":"He makes works that grow and change without him: bees, fish, algae, a dog.","fr":"Il crée des œuvres qui poussent et changent sans lui : abeilles, poissons, algues, un chien.","es":"Crea obras que crecen y cambian sin él: abejas, peces, algas, un perro."},{"en":"For documenta in 2012 he turned a compost heap into a world, with a white dog named Human.","fr":"Pour la documenta de 2012, il fait d’un tas de compost un monde, avec un chien blanc nommé Human.","es":"Para la documenta de 2012 convirtió un montón de compost en un mundo, con un perro blanco llamado Human."},{"en":"No two visits are the same: the piece keeps going when everyone has left.","fr":"Aucune visite ne se ressemble : l’œuvre continue quand tout le monde est parti.","es":"Ninguna visita es igual: la obra sigue cuando todos se han ido."}],"fact":{"en":"Human, the dog in his documenta piece, had one leg painted bright pink.","fr":"Human, la chienne de son œuvre à la documenta, avait une patte peinte en rose vif.","es":"Human, la perra de su obra en la documenta, tenía una pata pintada de rosa intenso."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/MoMa_NY_USA_1.jpg/960px-MoMa_NY_USA_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"MoMA, New York"},{"id":"hammershoi","artist":"Vilhelm Hammershøi","headline":{"en":"The quietest painter","fr":"Le peintre du silence","es":"El pintor del silencio"},"lines":[{"en":"He painted the rooms of his Copenhagen flat over and over: doors, windows, light on the floor.","fr":"Il peint encore et encore les pièces de son appartement de Copenhague : portes, fenêtres, lumière au sol.","es":"Pintó una y otra vez las habitaciones de su piso de Copenhague: puertas, ventanas, luz en el suelo."},{"en":"His palette is grey, white and black, with almost no colour.","fr":"Sa palette : gris, blanc, noir, presque pas de couleur.","es":"Su paleta es gris, blanca y negra, casi sin color."},{"en":"When someone is there, it is usually his wife Ida, seen from behind.","fr":"Quand quelqu’un est là, c’est souvent sa femme Ida, vue de dos.","es":"Cuando hay alguien, suele ser su mujer, Ida, vista de espaldas."}],"fact":{"en":"Most of his interiors show one address: Strandgade 30, where he lived from 1898 to 1909. He often left out furniture and even door handles, to make the rooms emptier.","fr":"La plupart de ses intérieurs montrent une seule adresse : Strandgade 30, où il vit de 1898 à 1909. Il omet souvent meubles et même poignées de porte, pour vider les pièces.","es":"Casi todos sus interiores muestran una sola dirección: Strandgade 30, donde vivió de 1898 a 1909. A menudo omitía muebles e incluso pomos para vaciar las habitaciones."},"eventID":null,"imageURL":"https://www.frick.org/sites/default/files/styles/social_media/public/images/2026/08/2027_hammershoi_interior_music_strandgade30_2000_1687_web.jpg?itok=9214B_XE","imagePlace":"Frick Collection, New York"},{"id":"nara","artist":"Yoshitomo Nara","headline":{"en":"The girls who don’t smile","fr":"Les filles qui ne sourient pas","es":"Las niñas que no sonríen"},"lines":[{"en":"His children have huge heads and narrowed eyes, sometimes holding a knife or a cigarette.","fr":"Ses enfants ont une tête énorme et des yeux plissés, parfois un couteau ou une cigarette à la main.","es":"Sus niños tienen cabezas enormes y ojos entornados, a veces con un cuchillo o un cigarrillo."},{"en":"He grew up alone a lot in northern Japan, with the radio and punk records.","fr":"Il a grandi souvent seul, dans le nord du Japon, avec la radio et des disques punk.","es":"Creció mucho tiempo solo en el norte de Japón, con la radio y discos de punk."},{"en":"They look cute and angry at once, like a song turned up loud.","fr":"Ils sont à la fois mignons et en colère, comme une chanson à fond.","es":"Son a la vez tiernos y furiosos, como una canción a todo volumen."}],"fact":{"en":"He studied art in Düsseldorf in the 1990s and stayed twelve years in Germany, where his famous children first appeared.","fr":"Il a étudié l’art à Düsseldorf dans les années 1990 et a passé douze ans en Allemagne, où sont nés ses célèbres enfants.","es":"Estudió arte en Düsseldorf en los noventa y pasó doce años en Alemania, donde nacieron sus famosos niños."},"eventID":null,"imageURL":"https://cdn.sanity.io/images/juzvn5an/release-adp/74092f28c1a70ef4cdee8844b3746cb827dfbd3c-3000x1688.jpg?bg=ffffff&w=1200&h=630&fit=fill&crop=entropy&auto=format","imagePlace":"David Zwirner, New York"},{"id":"baselitz","artist":"Georg Baselitz","headline":{"en":"He turned painting upside down","fr":"Il a mis la peinture à l’envers","es":"Puso la pintura del revés"},"lines":[{"en":"Born Hans-Georg Kern in East Germany, he took his name from his home village, Deutschbaselitz.","fr":"Né Hans-Georg Kern en Allemagne de l’Est, il prend le nom de son village natal, Deutschbaselitz.","es":"Nacido Hans-Georg Kern en Alemania del Este, tomó el nombre de su pueblo, Deutschbaselitz."},{"en":"Since 1969 he has painted his figures upside down.","fr":"Depuis 1969, il peint ses figures la tête en bas.","es":"Desde 1969 pinta sus figuras boca abajo."},{"en":"That way, he said, you look at the painting, not at what it shows.","fr":"Comme ça, dit-il, on regarde la peinture et pas ce qu’elle montre.","es":"Así, decía, se mira la pintura y no lo que muestra."}],"fact":{"en":"At his first show in West Berlin, in 1963, the police seized two of his paintings for indecency.","fr":"Lors de sa première exposition à Berlin-Ouest, en 1963, la police saisit deux de ses tableaux pour indécence.","es":"En su primera exposición en Berlín Occidental, en 1963, la policía confiscó dos cuadros por indecencia."},"eventID":null,"imageURL":"https://upload.wikimedia.org/wikipedia/commons/2/22/The_West_24th_Street_Gallery%2C_Gagosian_Gallery_Nov_26%2C_2019.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","imagePlace":"Gagosian, New York"},{"id":"serra","artist":"Richard Serra","headline":{"en":"Steel you walk through","fr":"L’acier qu’on traverse","es":"Acero que se recorre"},"lines":[{"en":"He paid for art school by working in steel mills in California.","fr":"Il paie ses études d’art en travaillant dans des aciéries de Californie.","es":"Se pagó la escuela de arte trabajando en acerías de California."},{"en":"His huge curved walls of steel lean and twist as you walk between them.","fr":"Ses immenses murs d’acier courbés penchent et se tordent quand on marche entre eux.","es":"Sus enormes muros curvos de acero se inclinan y retuercen al caminar entre ellos."},{"en":"They weigh hundreds of tonnes and stand up only by balance.","fr":"Ils pèsent des centaines de tonnes et ne tiennent que par l’équilibre.","es":"Pesan cientos de toneladas y se sostienen solo por equilibrio."}],"fact":{"en":"His Tilted Arc, a 37-metre steel wall across a Manhattan plaza, angered office workers so much that it was cut up and removed in 1989.","fr":"Son Tilted Arc, un mur d’acier de 37 mètres sur une place de Manhattan, a tant agacé les employés de bureau qu’il a été découpé et retiré en 1989.","es":"Su Tilted Arc, un muro de acero de 37 metros en una plaza de Manhattan, molestó tanto a los oficinistas que fue cortado y retirado en 1989."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Diabeacon_2006.jpg/960px-Diabeacon_2006.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"Dia Beacon, New York"},{"id":"smithson","artist":"Robert Smithson","headline":{"en":"The jetty that disappeared","fr":"La jetée qui avait disparu","es":"El muelle que desapareció"},"lines":[{"en":"In 1970 he built a spiral of black rock 460 metres long into the Great Salt Lake.","fr":"En 1970, il construit dans le Grand Lac Salé une spirale de roche noire de 460 mètres.","es":"En 1970 construyó en el Gran Lago Salado una espiral de roca negra de 460 metros."},{"en":"Spiral Jetty sank under the water a few years later and stayed hidden for decades.","fr":"Quelques années plus tard, Spiral Jetty disparaît sous l’eau pendant des décennies.","es":"Pocos años después, Spiral Jetty quedó bajo el agua durante décadas."},{"en":"Droughts brought it back, crusted white with salt.","fr":"Les sécheresses l’ont fait réapparaître, couverte de sel blanc.","es":"Las sequías la hicieron reaparecer, cubierta de sal blanca."}],"fact":{"en":"He died in 1973, aged 35, when the small plane he was in crashed while he was looking at a site for a new earthwork in Texas.","fr":"Il meurt en 1973, à 35 ans, dans l’accident du petit avion d’où il repérait le site d’une nouvelle œuvre au Texas.","es":"Murió en 1973, con 35 años, al estrellarse la avioneta desde la que buscaba el lugar de una nueva obra en Texas."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Diabeacon_2006.jpg/960px-Diabeacon_2006.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"Dia Beacon, New York"},{"id":"bradford","artist":"Mark Bradford","headline":{"en":"Paintings made of paper","fr":"Des tableaux en papier","es":"Cuadros de papel"},"lines":[{"en":"He worked for years as a hairdresser in his mother’s salon in Los Angeles.","fr":"Il a longtemps été coiffeur dans le salon de sa mère, à Los Angeles.","es":"Durante años fue peluquero en el salón de su madre, en Los Ángeles."},{"en":"His first big works used the little papers hairdressers use for perms.","fr":"Ses premières grandes œuvres utilisaient les papiers de permanente des coiffeurs.","es":"Sus primeras grandes obras usaban los papelitos de la permanente."},{"en":"Now he layers posters and paper, then sands them back, like maps of a city.","fr":"Aujourd’hui, il superpose affiches et papiers puis les ponce, comme des cartes de ville.","es":"Hoy superpone carteles y papel y luego los lija, como mapas de una ciudad."}],"fact":{"en":"He represented the United States at the 2017 Venice Biennale and filled the pavilion with a dripping sculpture you had to squeeze past to enter.","fr":"Il représente les États-Unis à la Biennale de Venise en 2017, où il faut se faufiler pour entrer dans le pavillon, envahi par une sculpture.","es":"Representó a Estados Unidos en la Bienal de Venecia de 2017, con una escultura que obligaba a colarse para entrar en el pabellón."},"eventID":null,"imageURL":"https://studiomuseum.imgix.net/images/20260928_MarkBradford_UntitledA-Z_KrisGraves_1.jpg","imagePlace":"The Studio Museum In Harlem, New York"},{"id":"monkman","artist":"Kent Monkman","headline":{"en":"History, repainted","fr":"L’histoire, repeinte","es":"La historia, repintada"},"lines":[{"en":"A Cree artist from Canada, he paints in the grand style of 19th-century history paintings.","fr":"Artiste cri du Canada, il peint dans le grand style de la peinture d’histoire du 19e siècle.","es":"Artista cree de Canadá, pinta con el gran estilo de la pintura de historia del siglo XIX."},{"en":"He turns their stories around: settlers become the strangers.","fr":"Il en renverse le récit : les colons deviennent les étrangers.","es":"Les da la vuelta al relato: los colonos se vuelven los extraños."},{"en":"His alter ego, Miss Chief Eagle Testickle, slips into the scenes in heels.","fr":"Son double, Miss Chief Eagle Testickle, s’invite dans les scènes, en talons.","es":"Su alter ego, Miss Chief Eagle Testickle, se cuela en las escenas con tacones."}],"fact":{"en":"In 2019 the Met asked him to paint two huge canvases for its Great Hall, the first commission of its kind in the museum’s history.","fr":"En 2019, le Met lui commande deux immenses toiles pour son grand hall, une première dans l’histoire du musée.","es":"En 2019 el Met le encargó dos lienzos enormes para su gran vestíbulo, el primer encargo así en la historia del museo."},"eventID":null,"imageURL":"https://www.frick.org/sites/default/files/styles/social_media/public/images/2026/05/2026_Kent_Monkman_bio_016A0824_2000_1333-web-q30.jpg?itok=okW_rfJl","imagePlace":"Frick Collection, New York"},{"id":"lee-miller","artist":"Lee Miller","headline":{"en":"From Vogue cover to the front line","fr":"De la couverture de Vogue au front","es":"De la portada de Vogue al frente"},"lines":[{"en":"She was a Vogue model in New York before moving to Paris to work with Man Ray.","fr":"Mannequin pour Vogue à New York, elle part à Paris travailler avec Man Ray.","es":"Fue modelo de Vogue en Nueva York antes de irse a París a trabajar con Man Ray."},{"en":"In the war she became a photographer for Vogue, at the liberation of Paris and the camps.","fr":"Pendant la guerre, elle photographie pour Vogue la libération de Paris et les camps.","es":"En la guerra fotografió para Vogue la liberación de París y los campos."},{"en":"After it, she hardly took pictures again, and hid her archive in the attic.","fr":"Après, elle ne photographie presque plus et cache ses archives au grenier.","es":"Después casi dejó la fotografía y escondió su archivo en el desván."}],"fact":{"en":"On 30 April 1945, the day Hitler died, she was photographed in his bathtub in Munich, her muddy boots from Dachau on the mat.","fr":"Le 30 avril 1945, jour de la mort d’Hitler, elle se fait photographier dans sa baignoire à Munich, ses bottes boueuses de Dachau sur le tapis.","es":"El 30 de abril de 1945, el día que murió Hitler, se fotografió en su bañera de Múnich, con las botas embarradas de Dachau en la alfombrilla."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f8/Art_Institute_of_Chicago_%2851575570710%29.jpg/960px-Art_Institute_of_Chicago_%2851575570710%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"The Art Institute of Chicago, Chicago"},{"id":"utamaro","artist":"Kitagawa Utamaro","headline":{"en":"The master of faces","fr":"Le maître des visages","es":"El maestro de los rostros"},"lines":[{"en":"In 1790s Edo, he made woodblock prints of women, close up, like portraits.","fr":"Dans l’Edo des années 1790, il grave des femmes en gros plan, comme des portraits.","es":"En el Edo de 1790 hizo grabados de mujeres en primer plano, como retratos."},{"en":"Courtesans, tea-house girls, mothers: each with her own gesture and mood.","fr":"Courtisanes, serveuses de maison de thé, mères : chacune avec son geste et son humeur.","es":"Cortesanas, camareras de casas de té, madres: cada una con su gesto y su ánimo."},{"en":"His prints reached Paris decades later and fascinated the Impressionists.","fr":"Ses estampes arrivent à Paris des décennies plus tard et fascinent les impressionnistes.","es":"Sus grabados llegaron a París décadas después y fascinaron a los impresionistas."}],"fact":{"en":"In 1804 he was handcuffed for 50 days for prints about the warlord Hideyoshi, a subject the shogunate had banned.","fr":"En 1804, il est condamné à 50 jours de menottes pour des estampes sur le seigneur Hideyoshi, sujet interdit par le shogunat.","es":"En 1804 lo condenaron a 50 días esposado por grabados sobre el señor Hideyoshi, un tema prohibido por el shogunato."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f8/Art_Institute_of_Chicago_%2851575570710%29.jpg/960px-Art_Institute_of_Chicago_%2851575570710%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"The Art Institute of Chicago, Chicago"},{"id":"abramovic","artist":"Marina Abramović","headline":{"en":"The body as material","fr":"Le corps comme matière","es":"El cuerpo como materia"},"lines":[{"en":"In 1974, in Naples, she laid 72 objects on a table and let the audience use them on her for six hours.","fr":"En 1974, à Naples, elle pose 72 objets sur une table et laisse le public s’en servir sur elle pendant six heures.","es":"En 1974, en Nápoles, puso 72 objetos sobre una mesa y dejó que el público los usara sobre ella durante seis horas."},{"en":"Among them: a rose, a feather, scissors and a loaded gun.","fr":"Parmi eux : une rose, une plume, des ciseaux et un pistolet chargé.","es":"Entre ellos: una rosa, una pluma, unas tijeras y una pistola cargada."},{"en":"Her work tests how far a body, and an audience, will go.","fr":"Son œuvre mesure jusqu’où va un corps, et un public.","es":"Su obra pone a prueba hasta dónde llega un cuerpo, y un público."}],"fact":{"en":"With her partner Ulay she ended their relationship in 1988 by walking the Great Wall of China from opposite ends, about 2,500 km each, to meet in the middle and say goodbye.","fr":"En 1988, avec son compagnon Ulay, elle met fin à leur histoire en parcourant la Grande Muraille depuis chaque extrémité, environ 2 500 km chacun, pour se dire adieu au milieu.","es":"En 1988 ella y su pareja Ulay pusieron fin a su relación recorriendo la Gran Muralla desde extremos opuestos, unos 2.500 km cada uno, para despedirse en el centro."},"eventID":null,"imageURL":"https://imgproxy.berlinonline.net/ygxqJOF-b_ixfMnu7YQZL9R1dL0yQH3dCS8nL582Ob0/resizing_type:fit/width:1200/height:1200/gravity:ce/enlarge:0/q:70/cb:2026110418/aHR0cHM6Ly9wb3B1bGEtbWlkZGxld2FyZS5zMy5hbWF6b25hd3MuY29tL2JvLW1pZGRsZXdhcmUvYm8uYmRlX2NoYW5uZWwuZXZlbnQvaW1hZ2VzLzUyL2NmODk0OTEyLTA1ODAtMTc5NS01MzM0LTJlZjBmZmFiMDhkYi5qcGc.jpg","imagePlace":"Neue Nationalgalerie, Berlin"},{"id":"gonzales","artist":"Eva Gonzalès","headline":{"en":"Manet’s only pupil","fr":"La seule élève de Manet","es":"La única alumna de Manet"},"lines":[{"en":"In 1869, at twenty, she became the only student Édouard Manet ever formally took on.","fr":"En 1869, à vingt ans, elle devient la seule élève qu’Édouard Manet ait jamais prise officiellement.","es":"En 1869, con veinte años, fue la única alumna que Édouard Manet aceptó formalmente."},{"en":"He painted her at her easel. She went on to show at the Salon under her own name.","fr":"Il la peint à son chevalet. Elle expose ensuite au Salon, sous son propre nom.","es":"Él la pintó ante el caballete. Ella expuso después en el Salón con su propio nombre."},{"en":"Her pastels of women at the theatre and at home are cooler and quieter than his.","fr":"Ses pastels de femmes au théâtre ou chez elles sont plus calmes et plus froids que les siens.","es":"Sus pasteles de mujeres en el teatro o en casa son más tranquilos y fríos que los de él."}],"fact":{"en":"She died in 1883, at 34, a few days after giving birth, and only days after Manet himself.","fr":"Elle meurt en 1883, à 34 ans, quelques jours après un accouchement et quelques jours seulement après Manet.","es":"Murió en 1883, con 34 años, días después de dar a luz y apenas días después que Manet."},"eventID":null,"imageURL":"https://www.parismusees.paris.fr/sites/default/files/2026-05/Eva%20Gonzal%C3%A8s%20%281847-1883%29.%20Parcours%20d%E2%80%99une%20artiste%20libre.png","imagePlace":"Petit Palais, Musée des beaux-arts de la Ville de Paris, Paris"},{"id":"schwitters","artist":"Kurt Schwitters","headline":{"en":"He built art out of rubbish","fr":"Il faisait de l’art avec des déchets","es":"Hizo arte con basura"},"lines":[{"en":"After the First World War he glued tickets, wrappers and scraps into collages.","fr":"Après la Première Guerre mondiale, il colle billets, emballages et bouts de papier en collages.","es":"Tras la Primera Guerra Mundial pegaba billetes, envoltorios y recortes en collages."},{"en":"He called it Merz, from a scrap of an advert for the Commerzbank.","fr":"Il appelle ça Merz, d’après un morceau de publicité pour la Commerzbank.","es":"Lo llamó Merz, por un trozo de anuncio del Commerzbank."},{"en":"In his house in Hanover, he slowly turned the rooms into one huge sculpture, the Merzbau.","fr":"Dans sa maison de Hanovre, il transforme peu à peu les pièces en une immense sculpture, le Merzbau.","es":"En su casa de Hannover convirtió poco a poco las habitaciones en una enorme escultura, el Merzbau."}],"fact":{"en":"The Merzbau was destroyed by a bombing raid in 1943. He had fled the Nazis and died in England in 1948, working on a new one in a barn in the Lake District.","fr":"Le Merzbau est détruit par un bombardement en 1943. Réfugié en Angleterre, il meurt en 1948 en construisant un nouveau, dans une grange de la région des Lacs.","es":"El Merzbau fue destruido por un bombardeo en 1943. Exiliado en Inglaterra, murió en 1948 mientras construía otro en un granero del Distrito de los Lagos."},"eventID":null,"imageURL":"https://cdn.paris.fr/qfapv4/2026/07/21/huge-bd7eb9277721936f7606a0130e156029.png","imagePlace":"Musée Picasso Paris, Paris"},{"id":"holzer","artist":"Jenny Holzer","headline":{"en":"Words in lights","fr":"Des mots en lumière","es":"Palabras de luz"},"lines":[{"en":"In the late 1970s she pasted short anonymous sentences around New York: her Truisms.","fr":"À la fin des années 1970, elle colle dans New York de courtes phrases anonymes : ses Truisms.","es":"A finales de los setenta pegó por Nueva York frases cortas y anónimas: sus Truisms."},{"en":"“Protect me from what I want.” “Abuse of power comes as no surprise.”","fr":"« Protégez-moi de ce que je veux. » « L’abus de pouvoir ne surprend personne. »","es":"«Protégeme de lo que quiero». «El abuso de poder no sorprende»."},{"en":"Then she put them on LED signs, stone benches and the facades of buildings.","fr":"Puis elle les met sur des panneaux LED, des bancs de pierre, des façades.","es":"Luego las puso en carteles LED, bancos de piedra y fachadas."}],"fact":{"en":"In 1982 her sentences ran on the giant electronic billboard in Times Square, between the adverts.","fr":"En 1982, ses phrases défilent sur l’écran géant de Times Square, entre deux publicités.","es":"En 1982 sus frases pasaron por la gran pantalla de Times Square, entre anuncios."},"eventID":null,"imageURL":"https://cdn.paris.fr/qfapv4/2026/08/24/huge-fad1c524e0d7feb4896cb9a36c60a19f.jpg","imagePlace":"Musée d'Orsay, Paris"},{"id":"celmins","artist":"Vija Celmins","headline":{"en":"Months for one wave","fr":"Des mois pour une vague","es":"Meses para una ola"},"lines":[{"en":"She fled Latvia with her family as a child during the war, and grew up in Indiana.","fr":"Enfant, elle fuit la Lettonie en guerre avec sa famille, et grandit dans l’Indiana.","es":"De niña huyó de Letonia en guerra con su familia y creció en Indiana."},{"en":"She draws the surface of the sea, night skies and spider webs, in pencil.","fr":"Elle dessine la surface de la mer, des ciels étoilés, des toiles d’araignée, au crayon.","es":"Dibuja la superficie del mar, cielos nocturnos y telarañas, a lápiz."},{"en":"One drawing can take months. Up close, it is just graphite. From afar, an ocean.","fr":"Un dessin peut lui prendre des mois. De près, du graphite. De loin, un océan.","es":"Un dibujo puede llevarle meses. De cerca, grafito. De lejos, un océano."}],"fact":{"en":"For To Fix the Image in Memory she collected eleven stones, then made bronze copies painted so exactly that the pairs can’t be told apart.","fr":"Pour To Fix the Image in Memory, elle ramasse onze cailloux et en fait des copies en bronze peintes si exactement qu’on ne distingue plus les paires.","es":"Para To Fix the Image in Memory recogió once piedras e hizo copias de bronce pintadas con tanta precisión que no se distinguen las parejas."},"eventID":null,"imageURL":"https://cdn.paris.fr/qfapv4/2026/07/20/huge-0444e993f76c74516d5f35df776ec748.jpg","imagePlace":"Musée de l'Orangerie, Paris"},{"id":"tintoretto","artist":"Tintoretto","headline":{"en":"The little dyer","fr":"Le petit teinturier","es":"El pequeño tintorero"},"lines":[{"en":"His father was a cloth dyer, a tintore: hence his nickname, the little dyer.","fr":"Son père était teinturier, tintore : d’où son surnom, le petit teinturier.","es":"Su padre era tintorero, tintore: de ahí su apodo, el pequeño tintorero."},{"en":"He painted so fast that rivals in Venice accused him of not finishing his canvases.","fr":"Il peint si vite que ses rivaux vénitiens l’accusent de ne pas finir ses toiles.","es":"Pintaba tan rápido que sus rivales venecianos lo acusaban de no terminar los lienzos."},{"en":"He spent over twenty years covering the walls and ceilings of the Scuola di San Rocco.","fr":"Il passe plus de vingt ans à couvrir les murs et plafonds de la Scuola di San Rocco.","es":"Pasó más de veinte años cubriendo paredes y techos de la Scuola di San Rocco."}],"fact":{"en":"To win the San Rocco competition in 1564, he didn’t bring a sketch like the others: he secretly installed a finished painting in the ceiling and gave it away as a gift.","fr":"Pour le concours de San Rocco en 1564, il n’apporte pas d’esquisse comme les autres : il installe en secret une toile achevée au plafond et l’offre.","es":"En el concurso de San Rocco de 1564 no llevó un boceto como los demás: instaló en secreto un lienzo terminado en el techo y lo regaló."},"eventID":null,"imageURL":"https://cdn.paris.fr/qfapv4/2026/08/24/huge-8e6460404bb768da7ec9cfeeaa5b8331.png","imagePlace":"Musée Jacquemart-André, Paris"},{"id":"kapoor","artist":"Anish Kapoor","headline":{"en":"The blackest black","fr":"Le noir le plus noir","es":"El negro más negro"},"lines":[{"en":"Born in Mumbai, he made his name in London with mounds of pure, powdery pigment.","fr":"Né à Bombay, il se fait connaître à Londres avec des tas de pigment pur, en poudre.","es":"Nacido en Bombay, se dio a conocer en Londres con montones de pigmento puro en polvo."},{"en":"His mirrors and voids swallow or flip the space around you.","fr":"Ses miroirs et ses vides avalent ou retournent l’espace autour de vous.","es":"Sus espejos y vacíos se tragan o voltean el espacio que te rodea."},{"en":"In Chicago, Cloud Gate is known to everyone simply as the Bean.","fr":"À Chicago, tout le monde appelle son Cloud Gate simplement « le Haricot ».","es":"En Chicago todo el mundo llama a su Cloud Gate simplemente «la Judía»."}],"fact":{"en":"In 2016 he bought the exclusive artistic rights to Vantablack, one of the darkest materials ever made. In protest, another artist made the world’s pinkest pink and sold it to everyone except Kapoor.","fr":"En 2016, il acquiert l’exclusivité artistique du Vantablack, l’un des matériaux les plus noirs jamais créés. En réponse, un autre artiste lance le rose le plus rose du monde, vendu à tous sauf à Kapoor.","es":"En 2016 compró la exclusividad artística del Vantablack, uno de los materiales más negros jamás creados. En protesta, otro artista lanzó el rosa más rosa del mundo, a la venta para todos salvo Kapoor."},"eventID":null,"imageURL":"https://staging-admin.mennour.com/uploads/img/og-image.png","imagePlace":"kamel mennour, Paris"},{"id":"mahama","artist":"Ibrahim Mahama","headline":{"en":"He wraps buildings in sacks","fr":"Il emballe les bâtiments de sacs","es":"Envuelve edificios con sacos"},"lines":[{"en":"He works in Ghana with old jute sacks, the ones used to ship cocoa and charcoal.","fr":"Il travaille au Ghana avec de vieux sacs de jute, ceux du cacao et du charbon.","es":"Trabaja en Ghana con viejos sacos de yute, los del cacao y el carbón."},{"en":"Hundreds of people stitch them together into vast patched curtains.","fr":"Des centaines de personnes les cousent en immenses rideaux rapiécés.","es":"Cientos de personas los cosen en enormes telones remendados."},{"en":"Draped over facades, they carry the story of trade and of the hands that handled them.","fr":"Posés sur des façades, ils racontent le commerce et les mains qui les ont portés.","es":"Sobre las fachadas cuentan la historia del comercio y de las manos que los cargaron."}],"fact":{"en":"At the 2015 Venice Biennale he covered the long walls of the Arsenale’s corridor with jute sacks.","fr":"À la Biennale de Venise de 2015, il recouvre de sacs de jute les longs murs du couloir de l’Arsenal.","es":"En la Bienal de Venecia de 2015 cubrió con sacos de yute los largos muros del corredor del Arsenal."},"eventID":null,"imageURL":"https://cdn.paris.fr/qfapv4/2026/08/24/huge-293c8985e0451057e2f4910a5492cbf1.jpg","imagePlace":"Fondation Cartier pour l'art contemporain, Paris"},{"id":"bartholdi","artist":"Auguste Bartholdi","headline":{"en":"He built Liberty in pieces","fr":"Il a construit la Liberté en morceaux","es":"Construyó la Libertad por piezas"},"lines":[{"en":"The sculptor from Colmar spent twenty years on the Statue of Liberty.","fr":"Le sculpteur colmarien consacre vingt ans à la statue de la Liberté.","es":"El escultor de Colmar dedicó veinte años a la Estatua de la Libertad."},{"en":"Gustave Eiffel designed the iron skeleton holding up its copper skin.","fr":"Gustave Eiffel conçoit le squelette de fer qui porte sa peau de cuivre.","es":"Gustave Eiffel diseñó el esqueleto de hierro que sostiene su piel de cobre."},{"en":"It was built in Paris, taken apart into 350 pieces and shipped to New York in 1885.","fr":"Elle est montée à Paris, démontée en 350 pièces et expédiée à New York en 1885.","es":"Se montó en París, se desmontó en 350 piezas y se envió a Nueva York en 1885."}],"fact":{"en":"To raise money, the arm and torch were shown on their own in Philadelphia in 1876 and then in Madison Square Park. Visitors paid to climb up to the balcony.","fr":"Pour lever des fonds, le bras et la torche sont exposés seuls à Philadelphie en 1876, puis à Madison Square. On payait pour monter jusqu’au balcon.","es":"Para recaudar fondos, el brazo y la antorcha se expusieron solos en Filadelfia en 1876 y luego en Madison Square. Se pagaba por subir al balcón."},"eventID":null,"imageURL":"https://cdn.paris.fr/qfapv4/2026/08/24/huge-9e092636f8a694ad5ca39661b18f1491.jpg","imagePlace":"Musée d'Orsay, Paris"},{"id":"morellet","artist":"François Morellet","headline":{"en":"Geometry with a wink","fr":"La géométrie avec humour","es":"Geometría con humor"},"lines":[{"en":"He ran the family toy factory in Cholet for decades while making his art.","fr":"Il a dirigé pendant des décennies l’usine de jouets familiale à Cholet, tout en faisant son œuvre.","es":"Durante décadas dirigió la fábrica familiar de juguetes en Cholet mientras hacía su obra."},{"en":"He made rules, chance and neon do the work: grids, tilted lines, random numbers.","fr":"Il laisse les règles, le hasard et le néon faire le travail : grilles, lignes penchées, chiffres tirés au sort.","es":"Dejaba que las reglas, el azar y el neón hicieran el trabajo: retículas, líneas inclinadas, números al azar."},{"en":"His titles are puns: he never took art too seriously.","fr":"Ses titres sont des calembours : il ne prenait jamais l’art trop au sérieux.","es":"Sus títulos son juegos de palabras: nunca se tomó el arte demasiado en serio."}],"fact":{"en":"In 2010 the Louvre installed his windows in a staircase, L’Esprit d’escalier: its first permanent contemporary work since Braque’s ceiling in 1953.","fr":"En 2010, le Louvre installe ses vitraux dans un escalier, L’Esprit d’escalier : sa première œuvre contemporaine permanente depuis le plafond de Braque en 1953.","es":"En 2010 el Louvre instaló sus vidrieras en una escalera, L’Esprit d’escalier: su primera obra contemporánea permanente desde el techo de Braque en 1953."},"eventID":null,"imageURL":"https://cdn.paris.fr/qfapv4/2026/08/24/huge-aaf8e0c1109688a2041e39f91a94e187.jpg","imagePlace":"Cité de l'architecture et du patrimoine, Paris"},{"id":"newton","artist":"Helmut Newton","headline":{"en":"Back to Berlin","fr":"Retour à Berlin","es":"De vuelta a Berlín"},"lines":[{"en":"Born in Berlin in 1920, he learned photography from the fashion photographer Yva.","fr":"Né à Berlin en 1920, il apprend la photo auprès de la photographe de mode Yva.","es":"Nacido en Berlín en 1920, aprendió fotografía con la fotógrafa de moda Yva."},{"en":"Jewish, he fled in 1938, and became famous decades later for bold, cool fashion pictures.","fr":"Juif, il fuit en 1938, et devient célèbre des décennies plus tard pour ses photos de mode audacieuses.","es":"Judío, huyó en 1938 y décadas después se hizo famoso por su fotografía de moda audaz."},{"en":"His foundation is next to Zoo station, the station he left Berlin from as a young man.","fr":"Sa fondation est à côté de la gare du Zoo, celle d’où il avait quitté Berlin jeune homme.","es":"Su fundación está junto a la estación del Zoo, desde la que se fue de Berlín de joven."}],"fact":{"en":"He died in 2004, at 83, when his car hit a wall as he drove out of the Chateau Marmont hotel in Los Angeles.","fr":"Il meurt en 2004, à 83 ans, quand sa voiture percute un mur à la sortie de l’hôtel Chateau Marmont, à Los Angeles.","es":"Murió en 2004, a los 83 años, cuando su coche chocó contra un muro al salir del hotel Chateau Marmont, en Los Ángeles."},"eventID":null,"imageURL":"https://www.smb.museum/typo3temp/assets/_processed_/1/8/csm_Helmut-Newton-One-off_xl_22cf2b9ffd.jpg","imagePlace":"Museum für Fotografie, Berlin"},{"id":"cattelan","artist":"Maurizio Cattelan","headline":{"en":"The banana on the wall","fr":"La banane au mur","es":"El plátano en la pared"},"lines":[{"en":"He never studied art and calls himself a professional troublemaker.","fr":"Il n’a jamais étudié l’art et se dit fauteur de troubles professionnel.","es":"Nunca estudió arte y se define como alborotador profesional."},{"en":"In 2019 he taped a banana to a wall at an art fair. It sold for $120,000.","fr":"En 2019, il scotche une banane au mur d’une foire. Elle se vend 120 000 dollars.","es":"En 2019 pegó un plátano a una pared en una feria. Se vendió por 120.000 dólares."},{"en":"Another artist peeled it off and ate it. It was simply replaced: the work is the idea.","fr":"Un autre artiste l’a décrochée et mangée. On l’a remplacée : l’œuvre, c’est l’idée.","es":"Otro artista lo despegó y se lo comió. Lo cambiaron: la obra es la idea."}],"fact":{"en":"His solid gold toilet, America, was stolen from Blenheim Palace in 2019, two days after it went on show. It was in working order.","fr":"Ses toilettes en or massif, America, ont été volées au palais de Blenheim en 2019, deux jours après leur installation. Elles fonctionnaient.","es":"Su inodoro de oro macizo, America, fue robado del palacio de Blenheim en 2019, dos días después de instalarlo. Funcionaba."},"eventID":null,"imageURL":"https://imgproxy.berlinonline.net/fewZNw45Gg6e-bJEXut6KwJcq7lxBCPu1cs3tTwSVqQ/resizing_type:fit/width:1200/height:1200/gravity:ce/enlarge:0/q:70/cb:2026110418/aHR0cHM6Ly9wb3B1bGEtbWlkZGxld2FyZS5zMy5hbWF6b25hd3MuY29tL2JvLW1pZGRsZXdhcmUvYm8uYmRlX2NoYW5uZWwuZXZlbnQvaW1hZ2VzLzc1LzcwOTkzY2IzLTJmZjctZTNmNy1kZDRiLTg2MDAwNjk2OWIxZi5qcGc.jpg","imagePlace":"Neue Nationalgalerie, Berlin"},{"id":"sakamoto","artist":"Ryuichi Sakamoto","headline":{"en":"Listening to a drowned piano","fr":"À l’écoute d’un piano noyé","es":"Escuchar un piano ahogado"},"lines":[{"en":"He was a pop star with Yellow Magic Orchestra, then won an Oscar for The Last Emperor.","fr":"Star de la pop avec le Yellow Magic Orchestra, il remporte un Oscar pour Le Dernier Empereur.","es":"Estrella del pop con Yellow Magic Orchestra, ganó un Óscar por El último emperador."},{"en":"Later he grew fascinated by sound itself: rain, ice, silence, noise.","fr":"Plus tard, il se passionne pour le son lui-même : pluie, glace, silence, bruit.","es":"Más tarde le fascinó el sonido en sí: lluvia, hielo, silencio, ruido."},{"en":"His installations let you see sound and hear time passing.","fr":"Ses installations font voir le son et entendre le temps qui passe.","es":"Sus instalaciones hacen ver el sonido y oír el paso del tiempo."}],"fact":{"en":"He recorded a piano that had survived the 2011 tsunami in Japan, out of tune and swollen with seawater. He said nature had retuned it.","fr":"Il a enregistré un piano rescapé du tsunami de 2011 au Japon, désaccordé et gonflé d’eau de mer. Pour lui, la nature l’avait réaccordé.","es":"Grabó un piano que sobrevivió al tsunami de 2011 en Japón, desafinado e hinchado de agua de mar. Decía que la naturaleza lo había vuelto a afinar."},"eventID":null,"imageURL":"https://www.smb.museum/typo3temp/assets/_processed_/3/c/csm_ryuichi-sakamoto-is-your-time-hamburger-bahnhof_xl_7f2ed1e714.jpg","imagePlace":"Hamburger Bahnhof - Nationalgalerie der Gegenwart, Berlin"},{"id":"weems","artist":"Carrie Mae Weems","headline":{"en":"A life at the kitchen table","fr":"Une vie autour de la table","es":"Una vida en la mesa de la cocina"},"lines":[{"en":"In 1990 she photographed herself at her kitchen table, under a single hanging lamp.","fr":"En 1990, elle se photographie à la table de sa cuisine, sous une seule lampe suspendue.","es":"En 1990 se fotografió en la mesa de su cocina, bajo una única lámpara colgante."},{"en":"Twenty pictures: a lover, a daughter, friends, then alone with a cigarette.","fr":"Vingt images : un amant, une fille, des amies, puis seule avec une cigarette.","es":"Veinte imágenes: un amante, una hija, amigas, y luego sola con un cigarrillo."},{"en":"The Kitchen Table Series became one of the great works on a Black woman’s life.","fr":"La Kitchen Table Series est devenue une œuvre majeure sur la vie d’une femme noire.","es":"La Kitchen Table Series se convirtió en una gran obra sobre la vida de una mujer negra."}],"fact":{"en":"She was the first African American woman to have a retrospective at the Guggenheim in New York, in 2014.","fr":"En 2014, elle est la première Afro-Américaine à avoir une rétrospective au Guggenheim de New York.","es":"En 2014 fue la primera mujer afroamericana con una retrospectiva en el Guggenheim de Nueva York."},"eventID":null,"imageURL":"https://co-berlin.org/sites/default/files/styles/ct_exhibition_default_mobile/public/2026-08/Web_CMW_HeartoftheMatter_1440x960.jpg?itok=QQoKaYMm","imagePlace":"TD Berlin, Berlin"},{"id":"corinth","artist":"Lovis Corinth","headline":{"en":"He painted on after a stroke","fr":"Il a continué à peindre après son attaque","es":"Siguió pintando tras el ictus"},"lines":[{"en":"By 1911 he was one of Berlin’s leading painters, loud, sensual and fast.","fr":"En 1911, c’est l’un des grands peintres de Berlin, bruyant, sensuel et rapide.","es":"En 1911 era uno de los grandes pintores de Berlín, ruidoso, sensual y rápido."},{"en":"That year a stroke left his hand trembling. He kept painting.","fr":"Cette année-là, une attaque lui laisse la main tremblante. Il continue de peindre.","es":"Ese año un ictus le dejó la mano temblorosa. Siguió pintando."},{"en":"His late views of the Walchensee lake are wild and loose, almost abstract.","fr":"Ses dernières vues du lac de Walchensee sont libres, presque abstraites.","es":"Sus últimas vistas del lago Walchensee son sueltas, casi abstractas."}],"fact":{"en":"He painted a self-portrait every year on his birthday.","fr":"Il peignait un autoportrait chaque année pour son anniversaire.","es":"Pintaba un autorretrato cada año en su cumpleaños."},"eventID":null,"imageURL":"https://imgproxy.berlinonline.net/d_xI6tmXzPembegr_QkqXg5TjPBMOSl5Lj_CpXLRNmE/resizing_type:fit/width:1200/height:1200/gravity:ce/enlarge:0/q:70/cb:2026110418/aHR0cHM6Ly9wb3B1bGEtbWlkZGxld2FyZS5zMy5hbWF6b25hd3MuY29tL2JvLW1pZGRsZXdhcmUvYm8uYmRlX2NoYW5uZWwuZXZlbnQvaW1hZ2VzLzEzNC81MGVmYjlhYS0yZDU4LTU5ZjgtZWE4Ni01YTNhN2Y2MDc3MmMuanBn.jpg","imagePlace":"Berlinische Galerie, Berlin"},{"id":"schlingensief","artist":"Christoph Schlingensief","headline":{"en":"Theatre as provocation","fr":"Le théâtre comme provocation","es":"El teatro como provocación"},"lines":[{"en":"He made films, plays, operas and TV shows, all of them scandals.","fr":"Il fait des films, des pièces, des opéras et des émissions de télé, toujours scandaleux.","es":"Hizo películas, obras, óperas y programas de televisión, todos escandalosos."},{"en":"In Vienna in 2000 he put asylum seekers in a container and let the public vote them out, like reality TV.","fr":"À Vienne en 2000, il installe des demandeurs d’asile dans un conteneur et laisse le public les éliminer, comme à la téléréalité.","es":"En Viena, en 2000, metió a solicitantes de asilo en un contenedor y dejó que el público los expulsara, como en un reality."},{"en":"Ill with cancer, he began building an opera village in Burkina Faso.","fr":"Atteint d’un cancer, il lance la construction d’un village-opéra au Burkina Faso.","es":"Enfermo de cáncer, empezó a construir una aldea-ópera en Burkina Faso."}],"fact":{"en":"The village he started, Opera Village Africa, still runs a school near Ouagadougou. He died in 2010, before it was finished.","fr":"Le village qu’il a lancé, l’Opera Village Africa, fait toujours tourner une école près de Ouagadougou. Il meurt en 2010, avant la fin du chantier.","es":"La aldea que inició, Opera Village Africa, sigue teniendo una escuela cerca de Uagadugú. Murió en 2010, antes de terminarla."},"eventID":null,"imageURL":"https://www.berlinerfestspiele.de/magnoliaPublic/.imaging/mte/bfs-de-fe/meta/dam/bfs-de/Gropius-Bau/2026/gb26_christoph_schlingensief/gb26_motiv_schlingensief_3zu2.jpg/jcr:content/Motiv_Schlingensief_2zu1.jpg","imagePlace":"Gropius-Bau, Berlin"},{"id":"hiller","artist":"Susan Hiller","headline":{"en":"An anthropologist of dreams","fr":"Une anthropologue des rêves","es":"Una antropóloga de los sueños"},"lines":[{"en":"An American who trained as an anthropologist, she settled in London and turned to art.","fr":"Américaine formée à l’anthropologie, elle s’installe à Londres et passe à l’art.","es":"Estadounidense formada en antropología, se instaló en Londres y se pasó al arte."},{"en":"She collected what culture throws away: postcards, ghost stories, recorded voices.","fr":"Elle collecte ce que la culture jette : cartes postales, histoires de fantômes, voix enregistrées.","es":"Coleccionaba lo que la cultura desecha: postales, historias de fantasmas, voces grabadas."},{"en":"Her works ask what we believe without saying so.","fr":"Ses œuvres interrogent ce que nous croyons sans le dire.","es":"Sus obras preguntan lo que creemos sin decirlo."}],"fact":{"en":"For Dream Mapping, in 1974, she and a group of friends slept outdoors inside fairy rings of mushrooms, then drew their dreams.","fr":"Pour Dream Mapping, en 1974, elle et des amis dorment dehors au milieu de ronds de sorcière, puis dessinent leurs rêves.","es":"Para Dream Mapping, en 1974, ella y unos amigos durmieron al aire libre dentro de corros de brujas de setas y luego dibujaron sus sueños."},"eventID":null,"imageURL":"https://imgproxy.berlinonline.net/l5Jm2x1uB0jDrIYCj_h7tL4DcP35KYMvdSUB7YPIFd4/resizing_type:fit/width:1200/height:1200/gravity:ce/enlarge:0/q:70/cb:2026110418/aHR0cHM6Ly9wb3B1bGEtbWlkZGxld2FyZS5zMy5hbWF6b25hd3MuY29tL2JkZS1jbXMvYm8udGIuZXZlbnQvaW1hZ2VzLzE2Ni82NmY4MzdjNC00YmQyLTQzMGItYjFhNi00MDRlNzNlNzc4NDUuanBn.jpg","imagePlace":"KW Institute for Contemporary Art, Berlin"},{"id":"miro","artist":"Joan Miró","headline":{"en":"He wanted to murder painting","fr":"Il voulait assassiner la peinture","es":"Quería asesinar la pintura"},"lines":[{"en":"Born in Barcelona in 1893, he worked as an office clerk until he fell ill.","fr":"Né à Barcelone en 1893, il est employé de bureau jusqu’à tomber malade.","es":"Nacido en Barcelona en 1893, trabajó de oficinista hasta que enfermó."},{"en":"In the 1920s he declared he wanted to “assassinate painting”, and invented a language of stars and signs.","fr":"Dans les années 1920, il déclare vouloir « assassiner la peinture », et invente un langage d’étoiles et de signes.","es":"En los años veinte declaró querer «asesinar la pintura» e inventó un lenguaje de estrellas y signos."},{"en":"His foundation on Montjuïc opened in 1975, in a building by his friend Josep Lluís Sert.","fr":"Sa fondation, sur Montjuïc, ouvre en 1975 dans un bâtiment de son ami Josep Lluís Sert.","es":"Su fundación en Montjuïc abrió en 1975 en un edificio de su amigo Josep Lluís Sert."}],"fact":{"en":"You see his work every day in Spain without knowing: he drew the sun logo of Spanish tourism, and the star of the bank La Caixa.","fr":"On voit son travail tous les jours en Espagne sans le savoir : il a dessiné le soleil du tourisme espagnol et l’étoile de La Caixa.","es":"Ves su obra a diario en España sin saberlo: dibujó el sol del turismo español y la estrella de La Caixa."},"eventID":"cat-20260309001","imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Fundaci%C3%B3_Joan_Mir%C3%B3_-_Barcelona_%28Catalonia%29.jpg/960px-Fundaci%C3%B3_Joan_Mir%C3%B3_-_Barcelona_%28Catalonia%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"Fundació Joan Miró, Barcelona"},{"id":"picasso","artist":"Pablo Picasso","headline":{"en":"The drawing on a Barcelona facade","fr":"Le dessin d’une façade barcelonaise","es":"El dibujo de una fachada de Barcelona"},"lines":[{"en":"He arrived in Barcelona at 13 and spent his formative years there, around the bar Els Quatre Gats.","fr":"Arrivé à Barcelone à 13 ans, il y passe ses années de formation, autour du bar Els Quatre Gats.","es":"Llegó a Barcelona a los 13 años y pasó allí sus años de formación, en torno al bar Els Quatre Gats."},{"en":"He never went back after Franco took power, but stayed close to the city.","fr":"Il n’y revient jamais après l’arrivée de Franco, mais reste proche de la ville.","es":"No volvió tras la llegada de Franco, pero siguió unido a la ciudad."},{"en":"In 1962 he drew the giant friezes on the architects’ college across from the cathedral.","fr":"En 1962, il dessine les frises géantes du collège des architectes, face à la cathédrale.","es":"En 1962 dibujó los frisos gigantes del colegio de arquitectos, frente a la catedral."}],"fact":{"en":"He never touched that facade: he sent drawings from France, and the Norwegian artist Carl Nesjar sandblasted them into the concrete.","fr":"Il n’a jamais touché cette façade : il a envoyé ses dessins de France, et l’artiste norvégien Carl Nesjar les a gravés au jet de sable dans le béton.","es":"Nunca tocó esa fachada: envió los dibujos desde Francia y el artista noruego Carl Nesjar los grabó con chorro de arena en el hormigón."},"eventID":"bcn-99400787498","imageURL":"https://estatics-nasia.dtibcn.cat/nasia-pro/media/BIG_Picasso_arquitectura_760_X_428_px.ee90a454b.jpg","imagePlace":null},{"id":"perriand","artist":"Charlotte Perriand","headline":{"en":"Not here to embroider cushions","fr":"Pas là pour broder des coussins","es":"No vino a bordar cojines"},"lines":[{"en":"In 1927 she asked Le Corbusier for a job. He told her: “We don’t embroider cushions here.”","fr":"En 1927, elle demande du travail à Le Corbusier. Il lui répond : « Ici, on ne brode pas de coussins. »","es":"En 1927 pidió trabajo a Le Corbusier. Él le respondió: «Aquí no bordamos cojines»."},{"en":"Then he saw her steel-and-glass bar at the Salon d’Automne, and hired her.","fr":"Puis il voit son bar en acier et en verre au Salon d’automne, et l’embauche.","es":"Luego vio su bar de acero y vidrio en el Salón de Otoño, y la contrató."},{"en":"She co-designed the famous chaise longue, then spent years learning from Japanese craft.","fr":"Elle cosigne la célèbre chaise longue, puis passe des années à apprendre de l’artisanat japonais.","es":"Codiseñó la famosa chaise longue y luego pasó años aprendiendo de la artesanía japonesa."}],"fact":{"en":"In 1940 she sailed to Japan as an adviser on design. When the war cut her off, she spent years in Vietnam, and came back with a lifelong love of bamboo and wood.","fr":"En 1940, elle part au Japon comme conseillère en design. Bloquée par la guerre, elle passe des années au Vietnam et revient avec un amour durable du bambou et du bois.","es":"En 1940 viajó a Japón como asesora de diseño. Atrapada por la guerra, pasó años en Vietnam y volvió con un amor duradero por el bambú y la madera."},"eventID":"cat-2026091800016","imageURL":"https://agenda.cultura.gencat.cat/content/dam/agenda/ca/activitats/2026/09/18/000/16/annexos/charlotte-app.jpg","imagePlace":null},{"id":"wojnarowicz","artist":"David Wojnarowicz","headline":{"en":"Rage as a work of art","fr":"La rage comme œuvre","es":"La rabia como obra"},"lines":[{"en":"He grew up partly on the streets of New York, and became a painter, writer, photographer and filmmaker.","fr":"Il a grandi en partie dans la rue à New York, et devient peintre, écrivain, photographe et cinéaste.","es":"Creció en parte en la calle en Nueva York y fue pintor, escritor, fotógrafo y cineasta."},{"en":"He photographed friends wearing a mask of the poet Rimbaud, all over the city.","fr":"Il photographie des amis portant un masque du poète Rimbaud, partout dans la ville.","es":"Fotografió a amigos con una máscara del poeta Rimbaud por toda la ciudad."},{"en":"When AIDS killed his friends, and then him, his art turned to fury against silence.","fr":"Quand le sida emporte ses amis, puis lui, son art devient une colère contre le silence.","es":"Cuando el sida mató a sus amigos, y luego a él, su arte se volvió furia contra el silencio."}],"fact":{"en":"At a 1988 protest, he wore a jacket painted with: “If I die of AIDS, forget burial, just drop my body on the steps of the F.D.A.”","fr":"Lors d’une manifestation en 1988, il porte une veste où il a peint : « Si je meurs du sida, oubliez l’enterrement, jetez mon corps sur les marches de la FDA. »","es":"En una protesta en 1988 llevó una chaqueta pintada: «Si muero de sida, olvidad el entierro, tirad mi cuerpo en las escaleras de la FDA»."},"eventID":"virreina-una-historia-americana","imageURL":null,"imagePlace":null},{"id":"tapies","artist":"Antoni Tàpies","headline":{"en":"Paintings like old walls","fr":"Des tableaux comme de vieux murs","es":"Cuadros como muros viejos"},"lines":[{"en":"Bedridden with tuberculosis as a teenager, he began to draw.","fr":"Cloué au lit par la tuberculose à l’adolescence, il se met à dessiner.","es":"Postrado por la tuberculosis en la adolescencia, empezó a dibujar."},{"en":"He mixed marble dust, sand and varnish into thick surfaces scratched like walls.","fr":"Il mêle poussière de marbre, sable et vernis en surfaces épaisses, griffées comme des murs.","es":"Mezclaba polvo de mármol, arena y barniz en superficies gruesas, rayadas como muros."},{"en":"His name means walls in Catalan, and he made it his signature.","fr":"Son nom veut dire « murs » en catalan, et il en a fait sa signature.","es":"Su apellido significa «tapias», muros, y lo convirtió en su firma."}],"fact":{"en":"The tangle of tubes on the roof of his foundation in Barcelona is a sculpture: Cloud and Chair, 1990, made of aluminium tubing.","fr":"L’enchevêtrement de tubes sur le toit de sa fondation à Barcelone est une sculpture : Nuage et chaise, 1990, en tubes d’aluminium.","es":"La maraña de tubos sobre el tejado de su fundación en Barcelona es una escultura: Nube y silla, de 1990, en tubo de aluminio."},"eventID":"bcn-99400748337","imageURL":"https://estatics-nasia.dtibcn.cat/nasia-pro/media/3-Antoni-Tapies-Gris-1955.dbd72a08b.jpg","imagePlace":null},{"id":"dali","artist":"Salvador Dalí","headline":{"en":"Too good for his teachers","fr":"Trop fort pour ses professeurs","es":"Demasiado para sus profesores"},"lines":[{"en":"As a student in Madrid he lived at the Residencia de Estudiantes, with Lorca and Buñuel.","fr":"Étudiant à Madrid, il vit à la Residencia de Estudiantes, avec Lorca et Buñuel.","es":"De estudiante en Madrid vivió en la Residencia de Estudiantes, con Lorca y Buñuel."},{"en":"In 1926 he refused to sit his final exam, saying no professor was fit to judge him. He was expelled.","fr":"En 1926, il refuse de passer l’examen final, aucun professeur n’étant digne de le juger. Il est renvoyé.","es":"En 1926 se negó a examinarse porque ningún profesor era digno de juzgarlo. Lo expulsaron."},{"en":"Three years later he joined the Surrealists in Paris.","fr":"Trois ans plus tard, il rejoint les surréalistes à Paris.","es":"Tres años después se unió a los surrealistas en París."}],"fact":{"en":"At a London lecture in 1936 he appeared in a diving suit and nearly suffocated. Someone had to free him with a spanner.","fr":"À une conférence à Londres en 1936, il apparaît en scaphandre et manque d’étouffer. Il faut le délivrer avec une clé à molette.","es":"En una conferencia en Londres en 1936 apareció con escafandra y casi se asfixia. Tuvieron que liberarlo con una llave inglesa."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Site_of_the_Retiro_and_the_Prado_in_Madrid_49_%2829684554308%29.jpg/960px-Site_of_the_Retiro_and_the_Prado_in_Madrid_49_%2829684554308%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"Museo Thyssen-Bornemisza, Madrid"},{"id":"minujin","artist":"Marta Minujín","headline":{"en":"A maze you crawl through","fr":"Un labyrinthe à traverser","es":"Un laberinto para atravesar"},"lines":[{"en":"In 1965 in Buenos Aires she built La Menesunda, a walk-through maze of strange rooms.","fr":"En 1965 à Buenos Aires, elle crée La Menesunda, un labyrinthe de pièces étranges à traverser.","es":"En 1965, en Buenos Aires, creó La Menesunda, un laberinto de habitaciones extrañas para recorrer."},{"en":"Neon, a couple in bed, a beautician, a giant head, a fridge: people queued around the block.","fr":"Néons, un couple au lit, une esthéticienne, une tête géante, un frigo : la file faisait le tour du pâté de maisons.","es":"Neones, una pareja en la cama, una esteticista, una cabeza gigante, una nevera: la cola daba la vuelta a la manzana."},{"en":"Her art is meant to be lived, eaten, or taken home.","fr":"Son art est fait pour être vécu, mangé, ou emporté.","es":"Su arte está hecho para vivirse, comerse o llevarse a casa."}],"fact":{"en":"For documenta in 2017 she built a full-size Parthenon in Kassel out of 100,000 books that had been banned somewhere in the world.","fr":"Pour la documenta de 2017, elle construit à Kassel un Parthénon grandeur nature avec 100 000 livres interdits quelque part dans le monde.","es":"Para la documenta de 2017 levantó en Kassel un Partenón a tamaño real con 100.000 libros prohibidos en algún lugar del mundo."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/97/MNCARS_05.jpg/960px-MNCARS_05.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"Museo Nacional Centro de Arte Reina Sofía, Madrid"},{"id":"scharf","artist":"Kenny Scharf","headline":{"en":"Cartoons from outer space","fr":"Des cartoons de l’espace","es":"Dibujos animados del espacio"},"lines":[{"en":"In 1980s New York he shared a flat and the street scene with Keith Haring and Basquiat.","fr":"Dans le New York des années 1980, il partage un appartement et la rue avec Keith Haring et Basquiat.","es":"En el Nueva York de los ochenta compartió piso y calle con Keith Haring y Basquiat."},{"en":"He painted the Jetsons and the Flintstones into wild pop-surreal worlds.","fr":"Il peint les Jetson et les Pierrafeu dans des mondes pop et surréalistes déchaînés.","es":"Pintó a los Supersónicos y los Picapiedra en mundos pop y surrealistas desatados."},{"en":"He covered fridges, TVs and car bodies with his blobby faces.","fr":"Il couvre frigos, télés et carrosseries de ses visages en bulles.","es":"Cubrió neveras, televisores y carrocerías con sus caras burbujeantes."}],"fact":{"en":"He built a Cosmic Cavern in his closet: a tiny room of junk, toys and fluorescent paint, glowing under black light, where friends came to dance.","fr":"Il a construit une Cosmic Cavern dans son placard : une petite pièce de bric-à-brac, de jouets et de peinture fluo sous lumière noire, où ses amis venaient danser.","es":"Construyó una Cosmic Cavern en su armario: un cuartito de trastos, juguetes y pintura fluorescente bajo luz negra, donde sus amigos iban a bailar."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Site_of_the_Retiro_and_the_Prado_in_Madrid_49_%2829684554308%29.jpg/960px-Site_of_the_Retiro_and_the_Prado_in_Madrid_49_%2829684554308%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"Museo Thyssen-Bornemisza, Madrid"},{"id":"baldung","artist":"Hans Baldung Grien","headline":{"en":"Dürer’s darkest pupil","fr":"Le plus sombre élève de Dürer","es":"El alumno más oscuro de Durero"},"lines":[{"en":"He trained in Albrecht Dürer’s workshop in Nuremberg around 1503.","fr":"Il se forme dans l’atelier d’Albrecht Dürer à Nuremberg vers 1503.","es":"Se formó en el taller de Alberto Durero en Núremberg hacia 1503."},{"en":"He loved strange subjects: witches flying on goats, Death embracing young women.","fr":"Il aime les sujets étranges : sorcières volant sur des boucs, la Mort enlaçant des jeunes femmes.","es":"Le atraían los temas extraños: brujas volando en machos cabríos, la Muerte abrazando a jóvenes."},{"en":"His colours are cold and bright, his drawing sharp as a knife.","fr":"Ses couleurs sont froides et vives, son dessin tranchant comme un couteau.","es":"Sus colores son fríos y vivos; su dibujo, afilado como un cuchillo."}],"fact":{"en":"His nickname Grien, green, probably comes from his love of that colour, though nobody knows for sure.","fr":"Son surnom, Grien, « vert », vient probablement de son goût pour cette couleur, sans que personne en soit sûr.","es":"Su apodo, Grien, «verde», probablemente viene de su gusto por ese color, aunque nadie lo sabe con certeza."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/68/Museo_del_Prado_2016_%2825185969599%29.jpg/960px-Museo_del_Prado_2016_%2825185969599%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"Museo del Prado, Madrid"},{"id":"kandinsky","artist":"Vassily Kandinsky","headline":{"en":"A lawyer who heard colours","fr":"Un juriste qui entendait les couleurs","es":"Un jurista que oía los colores"},"lines":[{"en":"He taught law in Moscow until he was 30.","fr":"Il enseignait le droit à Moscou jusqu’à 30 ans.","es":"Enseñó Derecho en Moscú hasta los 30 años."},{"en":"Colours had sounds for him: yellow like a trumpet, blue like a cello.","fr":"Pour lui, les couleurs avaient un son : le jaune comme une trompette, le bleu comme un violoncelle.","es":"Para él los colores sonaban: el amarillo como una trompeta, el azul como un violonchelo."},{"en":"He became one of the first painters to leave the visible world behind.","fr":"Il devient l’un des premiers peintres à quitter le monde visible.","es":"Se convirtió en uno de los primeros pintores en dejar atrás el mundo visible."}],"fact":{"en":"What made him quit law was a Monet. In Moscow in 1896 he saw a Haystack and couldn’t tell what it showed, and was overwhelmed anyway.","fr":"C’est un Monet qui lui fait quitter le droit. À Moscou en 1896, il voit une Meule sans comprendre ce qu’elle représente, et en est bouleversé.","es":"Lo que le hizo dejar el Derecho fue un Monet. En Moscú, en 1896, vio un Almiar sin saber qué representaba, y aun así le conmovió."},"eventID":null,"imageURL":"https://www.mostrepalazzobonaparte.it/img/thumb-menu-kandinsky.jpg","imagePlace":"Palazzo Bonaparte, Rome"},{"id":"rivera","artist":"Diego Rivera","headline":{"en":"The mural Rockefeller destroyed","fr":"La fresque détruite par Rockefeller","es":"El mural que destruyó Rockefeller"},"lines":[{"en":"He brought fresco back to life in 1920s Mexico, covering public walls with history.","fr":"Il fait renaître la fresque dans le Mexique des années 1920, couvrant les murs publics d’histoire.","es":"Hizo renacer el fresco en el México de los años veinte, cubriendo muros públicos de historia."},{"en":"In 1933 the Rockefellers asked him for a mural in the lobby of their new tower in New York.","fr":"En 1933, les Rockefeller lui commandent une fresque pour le hall de leur nouvelle tour à New York.","es":"En 1933 los Rockefeller le encargaron un mural para el vestíbulo de su nueva torre en Nueva York."},{"en":"He painted Lenin into it and refused to remove him. The mural was covered, then smashed.","fr":"Il y peint Lénine et refuse de l’effacer. La fresque est couverte, puis détruite.","es":"Pintó a Lenin y se negó a borrarlo. El mural fue tapado y luego destruido."}],"fact":{"en":"He repainted it from photographs in Mexico City, at the Palacio de Bellas Artes, where it can still be seen.","fr":"Il l’a repeinte d’après des photos à Mexico, au Palacio de Bellas Artes, où on peut toujours la voir.","es":"Lo volvió a pintar a partir de fotografías en el Palacio de Bellas Artes de Ciudad de México, donde aún se ve."},"eventID":null,"imageURL":"https://www.museiincomuneroma.it/sites/default/files/f_mostraevento/diego_rivera_1050x545.jpg","imagePlace":"Musei Capitolini, Rome"},{"id":"titian","artist":"Titian","headline":{"en":"He finished with his fingers","fr":"Il finissait avec les doigts","es":"Terminaba con los dedos"},"lines":[{"en":"He was the most sought-after painter in Europe, painting popes, kings and the Emperor Charles V.","fr":"Il est le peintre le plus demandé d’Europe : papes, rois, l’empereur Charles Quint.","es":"Fue el pintor más solicitado de Europa: papas, reyes y el emperador Carlos V."},{"en":"He worked for some seventy years and changed style completely in old age.","fr":"Il peint pendant quelque soixante-dix ans et change complètement de manière en vieillissant.","es":"Pintó durante unos setenta años y cambió por completo de estilo en la vejez."},{"en":"A pupil wrote that in his last years he painted more with his fingers than his brushes.","fr":"Un élève raconte qu’à la fin, il peignait plus avec les doigts qu’avec les pinceaux.","es":"Un alumno contó que al final pintaba más con los dedos que con los pinceles."}],"fact":{"en":"Legend says Charles V once bent down to pick up a brush Titian had dropped, an emperor serving a painter.","fr":"Selon la légende, Charles Quint se serait penché pour ramasser un pinceau tombé des mains du Titien : un empereur au service d’un peintre.","es":"Cuenta la leyenda que Carlos V se agachó a recoger un pincel que se le cayó a Tiziano: un emperador al servicio de un pintor."},"eventID":null,"imageURL":"https://galleriaborghese.cultura.gov.it/wp-content/uploads/Tiziano-Web-e-Social-Mostre-1200x800-03.jpg","imagePlace":"Galleria Borghese, Rome"},{"id":"matta-clark","artist":"Gordon Matta-Clark","headline":{"en":"He cut houses in half","fr":"Il coupait les maisons en deux","es":"Cortaba casas por la mitad"},"lines":[{"en":"Son of the Surrealist painter Roberto Matta, he trained as an architect, then attacked buildings.","fr":"Fils du peintre surréaliste Roberto Matta, il étudie l’architecture, puis s’attaque aux bâtiments.","es":"Hijo del pintor surrealista Roberto Matta, estudió arquitectura y luego atacó edificios."},{"en":"In 1974 he sawed a house in New Jersey in two, and tilted one half so light poured through.","fr":"En 1974, il scie une maison du New Jersey en deux et incline une moitié pour laisser entrer la lumière.","es":"En 1974 serró en dos una casa de Nueva Jersey e inclinó una mitad para que entrara la luz."},{"en":"He worked only on buildings about to be demolished. Little survives but films and photos.","fr":"Il ne travaille que sur des bâtiments voués à la démolition. Il en reste surtout des films et des photos.","es":"Solo trabajaba en edificios a punto de demolerse. Quedan sobre todo películas y fotos."}],"fact":{"en":"In Paris in 1975 he carved a huge cone through two old houses next to the Centre Pompidou building site, just before they were knocked down.","fr":"À Paris en 1975, il creuse un immense cône à travers deux vieilles maisons voisines du chantier du Centre Pompidou, juste avant leur démolition.","es":"En París, en 1975, abrió un enorme cono a través de dos casas viejas junto a las obras del Centro Pompidou, justo antes de su demolición."},"eventID":null,"imageURL":"https://www.maxxi.art/wp-content/uploads/2026/10/gordonmattaclark_nottheworktheworker.jpg","imagePlace":"MAXXI Museo nazionale delle arti del XXI secolo, Rome"},{"id":"kentridge","artist":"William Kentridge","headline":{"en":"Drawings that move","fr":"Des dessins qui bougent","es":"Dibujos que se mueven"},"lines":[{"en":"In Johannesburg, he makes films from a single charcoal drawing.","fr":"À Johannesburg, il fait des films à partir d’un seul dessin au fusain.","es":"En Johannesburgo hace películas a partir de un solo dibujo al carboncillo."},{"en":"He draws, films a frame, rubs out, draws again, films again, hundreds of times.","fr":"Il dessine, filme une image, efface, redessine, refilme, des centaines de fois.","es":"Dibuja, filma un fotograma, borra, vuelve a dibujar, vuelve a filmar, cientos de veces."},{"en":"The ghost of each erased line stays on the paper, like memories of apartheid.","fr":"La trace de chaque ligne effacée reste sur le papier, comme les souvenirs de l’apartheid.","es":"El rastro de cada línea borrada queda en el papel, como los recuerdos del apartheid."}],"fact":{"en":"He also directs operas. He staged Shostakovich’s The Nose at the Met with dancing paper noses.","fr":"Il met aussi en scène des opéras, dont Le Nez de Chostakovitch au Met, avec des nez en papier qui dansent.","es":"También dirige óperas, como La nariz de Shostakóvich en el Met, con narices de papel que bailan."},"eventID":null,"imageURL":"https://agendabrussels2.imgix.net/c6ca5df0fd096545092e202c0d2fefad35ee0fd4.jpg","imagePlace":"Bozar, Brussels"},{"id":"ai-weiwei","artist":"Ai Weiwei","headline":{"en":"A hundred million seeds","fr":"Cent millions de graines","es":"Cien millones de semillas"},"lines":[{"en":"His father, a famous poet, was exiled to a labour camp; Ai grew up in a dugout in the desert.","fr":"Son père, poète célèbre, est exilé dans un camp de travail ; Ai grandit dans un abri creusé dans le désert.","es":"Su padre, un poeta famoso, fue desterrado a un campo de trabajo; Ai creció en un refugio excavado en el desierto."},{"en":"For Tate Modern in 2010 he filled the Turbine Hall with sunflower seeds made of porcelain.","fr":"Pour la Tate Modern en 2010, il remplit le Turbine Hall de graines de tournesol en porcelaine.","es":"Para la Tate Modern en 2010 llenó la Sala de Turbinas de pipas de girasol de porcelana."},{"en":"In 2011 he was detained by the Chinese authorities for 81 days without charge.","fr":"En 2011, il est détenu 81 jours par les autorités chinoises, sans inculpation.","es":"En 2011 las autoridades chinas lo detuvieron 81 días sin cargos."}],"fact":{"en":"There were about 100 million seeds, each painted by hand by some 1,600 craftspeople in Jingdezhen, China’s porcelain capital.","fr":"Il y avait environ 100 millions de graines, chacune peinte à la main par quelque 1 600 artisans de Jingdezhen, capitale chinoise de la porcelaine.","es":"Había unos 100 millones de pipas, cada una pintada a mano por unos 1.600 artesanos de Jingdezhen, la capital china de la porcelana."},"eventID":null,"imageURL":"https://agendabrussels2.imgix.net/e97c37a27214b551a14b6044dd5996cdcd7b1752.png","imagePlace":"Patrick Derom, Brussels"},{"id":"cragg","artist":"Tony Cragg","headline":{"en":"Rubbish, sorted by colour","fr":"Des déchets, triés par couleur","es":"Basura ordenada por colores"},"lines":[{"en":"Before art school he worked as a lab technician in rubber research.","fr":"Avant les beaux-arts, il est technicien de laboratoire dans la recherche sur le caoutchouc.","es":"Antes de la escuela de arte fue técnico de laboratorio en investigación del caucho."},{"en":"His early works were plastic scraps picked off beaches and laid out by colour.","fr":"Ses premières œuvres : des débris de plastique ramassés sur les plages et disposés par couleur.","es":"Sus primeras obras eran restos de plástico recogidos en playas y ordenados por colores."},{"en":"Now his sculptures twist like faces turning, in bronze, wood and steel.","fr":"Aujourd’hui, ses sculptures se tordent comme des visages qui tournent, en bronze, bois et acier.","es":"Hoy sus esculturas se retuercen como rostros que giran, en bronce, madera y acero."}],"fact":{"en":"In 1981 he made Britain Seen from the North: the map of Britain, turned on its side, in bits of found plastic, with himself standing beside it.","fr":"En 1981, il crée Britain Seen from the North : la carte de la Grande-Bretagne couchée sur le côté, en morceaux de plastique trouvés, avec lui-même à côté.","es":"En 1981 hizo Britain Seen from the North: el mapa de Gran Bretaña tumbado de lado, con trozos de plástico encontrados, y él mismo al lado."},"eventID":null,"imageURL":"https://agendabrussels2.imgix.net/b7e756b79ece9bf7e920b772ca2ff7e7a5fd260d.jpg","imagePlace":"Bernier/Eliades Gallery, Brussels"},{"id":"escher","artist":"M. C. Escher","headline":{"en":"The impossible staircase","fr":"L’escalier impossible","es":"La escalera imposible"},"lines":[{"en":"He nearly failed school and dropped out of architecture to study graphic art.","fr":"Il manque d’échouer à l’école et abandonne l’architecture pour la gravure.","es":"Casi suspende en el colegio y dejó la arquitectura por el grabado."},{"en":"He drew staircases that climb forever and hands drawing each other.","fr":"Il dessine des escaliers qui montent sans fin et des mains qui se dessinent l’une l’autre.","es":"Dibujó escaleras que suben sin fin y manos que se dibujan una a otra."},{"en":"Mathematicians loved him long before museums did.","fr":"Les mathématiciens l’ont aimé bien avant les musées.","es":"Los matemáticos lo admiraron mucho antes que los museos."}],"fact":{"en":"His interlocking birds and fish began in the Alhambra in Granada, where he spent days copying the Moorish tiles in 1922 and 1936.","fr":"Ses oiseaux et poissons imbriqués sont nés à l’Alhambra de Grenade, où il passe des jours à copier les carreaux mauresques en 1922 et 1936.","es":"Sus pájaros y peces encajados nacieron en la Alhambra de Granada, donde pasó días copiando los azulejos en 1922 y 1936."},"eventID":null,"imageURL":null,"imagePlace":null},{"id":"spilliaert","artist":"Léon Spilliaert","headline":{"en":"The insomniac of Ostend","fr":"L’insomniaque d’Ostende","es":"El insomne de Ostende"},"lines":[{"en":"The son of a perfumer in Ostend, he suffered from insomnia and walked the seafront at night.","fr":"Fils de parfumeur à Ostende, il souffre d’insomnie et arpente la digue la nuit.","es":"Hijo de un perfumista de Ostende, sufría insomnio y paseaba por el malecón de noche."},{"en":"He painted empty promenades, black sea, and himself staring from a mirror.","fr":"Il peint des promenades vides, la mer noire, et lui-même qui fixe un miroir.","es":"Pintó paseos vacíos, el mar negro y a sí mismo mirando desde un espejo."},{"en":"Mostly with ink, gouache and coloured pencil, on paper, not canvas.","fr":"Surtout à l’encre, à la gouache et aux crayons de couleur, sur papier, pas sur toile.","es":"Sobre todo con tinta, gouache y lápiz de color, en papel y no en lienzo."}],"fact":{"en":"His self-portraits of 1907–08, made at night in his room, are among the most unsettling images of early modern art.","fr":"Ses autoportraits de 1907-1908, faits la nuit dans sa chambre, comptent parmi les images les plus troublantes du début de l’art moderne.","es":"Sus autorretratos de 1907-1908, hechos de noche en su cuarto, están entre las imágenes más inquietantes del arte moderno temprano."},"eventID":null,"imageURL":"https://agendabrussels2.imgix.net/b0feb092cfa2260b2102542f0f054aefc93dedbc.jpg","imagePlace":"Boghossian Foundation, Brussels"},{"id":"balenciaga","artist":"Cristóbal Balenciaga","headline":{"en":"The couturier’s couturier","fr":"Le couturier des couturiers","es":"El modisto de los modistos"},"lines":[{"en":"A fisherman’s son from Getaria, in the Basque Country, he learned sewing from his mother.","fr":"Fils de pêcheur de Getaria, au Pays basque, il apprend la couture auprès de sa mère.","es":"Hijo de un pescador de Getaria, en el País Vasco, aprendió a coser con su madre."},{"en":"In Paris he invented new shapes: the balloon skirt, the sack dress, the baby doll.","fr":"À Paris, il invente des formes nouvelles : la jupe ballon, la robe sac, la baby doll.","es":"En París inventó formas nuevas: la falda globo, el vestido saco, el baby doll."},{"en":"He could cut, sew and fit a whole garment himself, rare among the great couturiers.","fr":"Il savait couper, coudre et ajuster seul un vêtement entier, chose rare chez les grands couturiers.","es":"Sabía cortar, coser y ajustar solo una prenda entera, algo raro entre los grandes modistos."}],"fact":{"en":"Christian Dior called him “the master of us all”. In 1968, refusing to make ready-to-wear, he simply closed his house.","fr":"Christian Dior l’appelait « notre maître à tous ». En 1968, refusant le prêt-à-porter, il ferme tout simplement sa maison.","es":"Christian Dior lo llamaba «el maestro de todos nosotros». En 1968, negándose al prêt-à-porter, simplemente cerró su casa."},"eventID":null,"imageURL":"https://agendabrussels2.imgix.net/5d3f12bd6eacd20d6eed9c05e947771362ded20e.jpg","imagePlace":"Bozar, Brussels"},{"id":"steinberg","artist":"Saul Steinberg","headline":{"en":"The world from Ninth Avenue","fr":"Le monde vu de la 9e Avenue","es":"El mundo desde la Novena Avenida"},"lines":[{"en":"Born in Romania, he trained as an architect in Milan and fled fascism in 1941.","fr":"Né en Roumanie, il étudie l’architecture à Milan et fuit le fascisme en 1941.","es":"Nacido en Rumanía, estudió arquitectura en Milán y huyó del fascismo en 1941."},{"en":"In New York, he drew for The New Yorker for almost sixty years.","fr":"À New York, il dessine pour le New Yorker pendant près de soixante ans.","es":"En Nueva York dibujó para The New Yorker durante casi sesenta años."},{"en":"A single line could be a road, a signature, a horizon and a joke at once.","fr":"Une seule ligne pouvait être une route, une signature, un horizon et une blague à la fois.","es":"Una sola línea podía ser carretera, firma, horizonte y chiste a la vez."}],"fact":{"en":"His 1976 cover View of the World from 9th Avenue shows Manhattan huge, then the Hudson, then a thin strip for the rest of America, then the Pacific. It has been copied by almost every city since.","fr":"Sa couverture de 1976, View of the World from 9th Avenue, montre Manhattan immense, puis l’Hudson, une mince bande pour le reste de l’Amérique, puis le Pacifique. Presque toutes les villes l’ont copiée.","es":"Su portada de 1976, View of the World from 9th Avenue, muestra Manhattan enorme, luego el Hudson, una franja fina para el resto de América y el Pacífico. Casi todas las ciudades la han copiado."},"eventID":null,"imageURL":"https://agendabrussels2.imgix.net/1585e344702ac6ddeccb264ccdeb197208ce0fbc.jpg","imagePlace":"Musées Royaux des Beaux-Arts de Belgique, Brussels"},{"id":"nkanga","artist":"Otobong Nkanga","headline":{"en":"What the earth gives up","fr":"Ce que la terre cède","es":"Lo que entrega la tierra"},"lines":[{"en":"Born in Nigeria, she works in Antwerp with tapestry, drawing, performance and minerals.","fr":"Née au Nigeria, elle travaille à Anvers avec la tapisserie, le dessin, la performance et les minéraux.","es":"Nacida en Nigeria, trabaja en Amberes con tapices, dibujo, performance y minerales."},{"en":"Her work follows the stones and metals dug out of the ground and the lives they change.","fr":"Son œuvre suit les pierres et les métaux arrachés au sol, et les vies qu’ils bouleversent.","es":"Su obra sigue las piedras y metales sacados de la tierra y las vidas que transforman."},{"en":"Mica, copper, malachite: the beauty and the wound are woven together.","fr":"Mica, cuivre, malachite : la beauté et la blessure sont tissées ensemble.","es":"Mica, cobre, malaquita: la belleza y la herida van tejidas juntas."}],"fact":{"en":"For documenta 14 she built a public soap-making workshop in Kassel, with oils from around the Mediterranean, to talk about trade and exchange.","fr":"Pour la documenta 14, elle installe à Kassel un atelier public de fabrication de savon, avec des huiles du pourtour méditerranéen, pour parler d’échange et de commerce.","es":"Para la documenta 14 montó en Kassel un taller público de jabón, con aceites de todo el Mediterráneo, para hablar de comercio e intercambio."},"eventID":null,"imageURL":"https://kanal.b-cdn.net/sites/default/files/sparklink/a0wSm000003v8yPIAQ.jpg?crop=2975%2C1556%2C0%2C2334&width=1200","imagePlace":"Kanal–Centre Pompidou, Brussels"},{"id":"vasconcelos","artist":"Joana Vasconcelos","headline":{"en":"A chandelier of tampons","fr":"Un lustre de tampons","es":"Una lámpara de tampones"},"lines":[{"en":"She makes giant works out of everyday things: saucepans, crochet, tampons, plastic cutlery.","fr":"Elle fait des œuvres géantes avec des objets du quotidien : casseroles, crochet, tampons, couverts en plastique.","es":"Hace obras gigantes con objetos cotidianos: cacerolas, ganchillo, tampones, cubiertos de plástico."},{"en":"Her Bride is a sparkling chandelier made of about 25,000 tampons.","fr":"Sa Mariée est un lustre scintillant fait d’environ 25 000 tampons.","es":"Su Novia es una lámpara de araña brillante hecha con unos 25.000 tampones."},{"en":"A pair of high heels, Marilyn, is built entirely from steel pans and lids.","fr":"Une paire d’escarpins, Marilyn, est entièrement faite de casseroles et de couvercles.","es":"Un par de tacones, Marilyn, está hecho solo de cacerolas y tapas."}],"fact":{"en":"In 2012 she was the first woman, and the youngest artist, to get a contemporary art show at the Palace of Versailles. The Bride was banned from it.","fr":"En 2012, elle est la première femme, et l’artiste la plus jeune, à exposer à Versailles. La Mariée en a été interdite.","es":"En 2012 fue la primera mujer, y la artista más joven, en exponer en Versalles. La Novia fue vetada."},"eventID":null,"imageURL":"https://www.maat.pt/sites/default/files/styles/in_time_detail/public/2026-10/venus-site_2.jpg?itok=5ebTsRBh","imagePlace":"Museu de Arte, Arquitetura e Tecnologia (MAAT), Lisbon"},{"id":"marisol","artist":"Marisol","headline":{"en":"The silent star of Pop","fr":"La star silencieuse du pop","es":"La estrella silenciosa del pop"},"lines":[{"en":"Born in Paris to Venezuelan parents, she became a sensation of 1960s New York.","fr":"Née à Paris de parents vénézuéliens, elle devient une sensation du New York des années 1960.","es":"Nacida en París de padres venezolanos, fue una sensación del Nueva York de los sesenta."},{"en":"She carved and painted wooden blocks into families, presidents and herself, many times over.","fr":"Elle sculpte et peint des blocs de bois : familles, présidents, et elle-même, encore et encore.","es":"Tallaba y pintaba bloques de madera: familias, presidentes y ella misma, una y otra vez."},{"en":"Andy Warhol put her in his films. Then she left the spotlight and was nearly forgotten.","fr":"Andy Warhol la filme. Puis elle quitte la lumière et tombe presque dans l’oubli.","es":"Andy Warhol la puso en sus películas. Luego dejó los focos y casi cayó en el olvido."}],"fact":{"en":"Famously quiet, she once took part in a panel of artists wearing a white mask, said nothing, and the audience demanded she take it off.","fr":"Très silencieuse, elle participe un jour à un débat d’artistes avec un masque blanc, sans dire un mot, et le public lui réclame de l’enlever.","es":"Famosa por su silencio, participó una vez en un debate de artistas con una máscara blanca, sin decir nada, y el público le pidió que se la quitara."},"eventID":null,"imageURL":"https://www.ccb.pt/wp-content/uploads/2025/11/10_creditoMarisol-Escobar_Untitled-1974_colored-pencil-and-collage-on-paper.-Bequest-of-Marisol-2016.jpg","imagePlace":"MAC/CCB, Lisbon"},{"id":"pomar","artist":"Júlio Pomar","headline":{"en":"A painter the dictatorship jailed","fr":"Un peintre emprisonné par la dictature","es":"Un pintor encarcelado por la dictadura"},"lines":[{"en":"In 1947, at 21, he was arrested by Salazar’s secret police and spent months in prison.","fr":"En 1947, à 21 ans, il est arrêté par la police secrète de Salazar et passe des mois en prison.","es":"En 1947, con 21 años, la policía secreta de Salazar lo detuvo y pasó meses en la cárcel."},{"en":"His mural for a cinema in Porto was painted over by the regime.","fr":"Sa fresque pour un cinéma de Porto est recouverte par le régime.","es":"Su mural para un cine de Oporto fue tapado por el régimen."},{"en":"He moved to Paris and kept painting bodies, tigers, bulls and horses in motion.","fr":"Il part à Paris et continue de peindre des corps, des tigres, des taureaux, des chevaux en mouvement.","es":"Se fue a París y siguió pintando cuerpos, tigres, toros y caballos en movimiento."}],"fact":{"en":"His old studio in Lisbon is now a small museum, the Atelier-Museu Júlio Pomar, converted by the architect Álvaro Siza.","fr":"Son ancien atelier à Lisbonne est aujourd’hui un petit musée, l’Atelier-Museu Júlio Pomar, transformé par l’architecte Álvaro Siza.","es":"Su antiguo estudio en Lisboa es hoy un pequeño museo, el Atelier-Museu Júlio Pomar, transformado por el arquitecto Álvaro Siza."},"eventID":null,"imageURL":"https://www.culturgest.pt/media/filer_public_thumbnails/filer_public/01/7a/017aecf1-e877-49cd-9e98-109f25844400/juliopomar-470486.png__1200x630_q85_crop_subsampling-2_upscale.jpg","imagePlace":"Culturgest, Lisbon"},{"id":"helena-almeida","artist":"Helena Almeida","headline":{"en":"She stepped into the painting","fr":"Elle est entrée dans le tableau","es":"Entró en el cuadro"},"lines":[{"en":"Daughter of a sculptor, she grew up in his Lisbon studio.","fr":"Fille de sculpteur, elle grandit dans son atelier de Lisbonne.","es":"Hija de escultor, creció en su estudio de Lisboa."},{"en":"From the 1970s she photographed herself painting, holding up or swallowing the paint.","fr":"À partir des années 1970, elle se photographie en train de peindre, tenant ou avalant la couleur.","es":"Desde los años setenta se fotografió pintando, sosteniendo o tragándose la pintura."},{"en":"In black-and-white pictures, only the blue is in colour. She called it Inhabited Painting.","fr":"Sur des photos en noir et blanc, seul le bleu est en couleur. Elle appelle ça Peinture habitée.","es":"En fotos en blanco y negro, solo el azul tiene color. Lo llamó Pintura habitada."}],"fact":{"en":"For forty years almost all her photographs were taken by her husband, the architect Artur Rosa, in her late father’s studio.","fr":"Pendant quarante ans, presque toutes ses photos sont prises par son mari, l’architecte Artur Rosa, dans l’ancien atelier de son père.","es":"Durante cuarenta años casi todas sus fotos las hizo su marido, el arquitecto Artur Rosa, en el antiguo estudio de su padre."},"eventID":null,"imageURL":"https://gulbenkian.pt/wp-content/uploads/2023/12/GalerieDrehschneibe_16x9.jpg","imagePlace":"Museu Calouste Gulbenkian, Lisbon"},{"id":"maruja-mallo","artist":"Maruja Mallo","headline":{"en":"The woman without a hat","fr":"La femme sans chapeau","es":"La mujer sin sombrero"},"lines":[{"en":"A painter of 1920s Madrid, friend of Lorca, Dalí and Alberti.","fr":"Peintre du Madrid des années 1920, amie de Lorca, Dalí et Alberti.","es":"Pintora del Madrid de los años veinte, amiga de Lorca, Dalí y Alberti."},{"en":"She painted fairs, carnivals and fishermen with surreal energy.","fr":"Elle peint fêtes foraines, carnavals et pêcheurs avec une énergie surréaliste.","es":"Pintaba verbenas, carnavales y pescadores con energía surrealista."},{"en":"Exiled in Buenos Aires during Franco’s years, she was long left out of Spanish art history.","fr":"Exilée à Buenos Aires pendant le franquisme, elle a longtemps été oubliée de l’histoire de l’art espagnol.","es":"Exiliada en Buenos Aires durante el franquismo, quedó mucho tiempo fuera de la historia del arte español."}],"fact":{"en":"She said that one day, with Dalí, Lorca and the painter Margarita Manso, she took off her hat in the Puerta del Sol, and passers-by threw stones. Women of her generation are now called Las Sinsombrero.","fr":"Elle racontait avoir ôté son chapeau Puerta del Sol avec Dalí, Lorca et la peintre Margarita Manso, sous les jets de pierres. On appelle aujourd’hui les femmes de sa génération Las Sinsombrero.","es":"Contaba que un día se quitó el sombrero en la Puerta del Sol con Dalí, Lorca y la pintora Margarita Manso, y la gente les tiró piedras. Hoy se llama a las mujeres de su generación Las Sinsombrero."},"eventID":null,"imageURL":"https://www.ccb.pt/wp-content/uploads/2026/07/Maruja-Mallo-Basuras-1930.-Coleccion-Centro-de-Arte-Fundacion-Maria-Jose-Jove-credito-VEGAP.jpg","imagePlace":"MAC/CCB, Lisbon"},{"id":"hicks","artist":"Sheila Hicks","headline":{"en":"A painter who chose thread","fr":"Une peintre qui a choisi le fil","es":"Una pintora que eligió el hilo"},"lines":[{"en":"She studied painting at Yale with Josef Albers, then switched to weaving.","fr":"Elle étudie la peinture à Yale avec Josef Albers, puis passe au tissage.","es":"Estudió pintura en Yale con Josef Albers y luego se pasó al tejido."},{"en":"Her works range from palm-sized weavings to waterfalls of coloured fibre.","fr":"Ses œuvres vont de tissages grands comme la main à des cascades de fibres colorées.","es":"Sus obras van de tejidos del tamaño de una mano a cascadas de fibra de color."},{"en":"She has lived in Paris since 1964, in a studio in the Latin Quarter.","fr":"Elle vit à Paris depuis 1964, dans un atelier du Quartier latin.","es":"Vive en París desde 1964, en un estudio del Barrio Latino."}],"fact":{"en":"She calls her small weavings minimes, and has made them on a little portable loom for over sixty years, wherever she travels.","fr":"Elle appelle ses petits tissages des « minimes », qu’elle tisse depuis plus de soixante ans sur un petit métier portatif, partout où elle voyage.","es":"Llama a sus pequeños tejidos «minimes» y los teje desde hace más de sesenta años en un telar portátil, allá donde viaje."},"eventID":null,"imageURL":"https://www.pacmilano.it/wp-content/uploads/2026/10/homepage-ENG-SH.jpg","imagePlace":"Padiglione d'Arte Contemporanea, Milan"},{"id":"fabro","artist":"Luciano Fabro","headline":{"en":"Italy, upside down","fr":"L’Italie à l’envers","es":"Italia del revés"},"lines":[{"en":"A key figure of Arte Povera, the Italian movement of humble materials.","fr":"Figure majeure de l’Arte Povera, le mouvement italien des matériaux pauvres.","es":"Figura clave del Arte Povera, el movimiento italiano de los materiales humildes."},{"en":"From 1968 he made maps of Italy in glass, lead, leather and gold, some hung upside down.","fr":"À partir de 1968, il fait des cartes de l’Italie en verre, plomb, cuir et or, certaines pendues à l’envers.","es":"Desde 1968 hizo mapas de Italia en vidrio, plomo, cuero y oro, algunos colgados del revés."},{"en":"He wanted sculpture to be something you live in, not just look at.","fr":"Il voulait une sculpture qu’on habite, pas seulement qu’on regarde.","es":"Quería una escultura para habitarla, no solo para mirarla."}],"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/08/HangarBicocca%2C_vue_du_haut_du_Hangar.jpg/960px-HangarBicocca%2C_vue_du_haut_du_Hangar.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"Pirelli HangarBicocca, Milan"},{"id":"wu-guanzhong","artist":"Wu Guanzhong","headline":{"en":"He burned his own paintings","fr":"Il brûlait ses propres tableaux","es":"Quemaba sus propios cuadros"},"lines":[{"en":"He studied in Paris after the war, then went home to China in 1950.","fr":"Il étudie à Paris après la guerre, puis rentre en Chine en 1950.","es":"Estudió en París tras la guerra y volvió a China en 1950."},{"en":"He brought together Chinese ink and Western painting: dots, lines and white space.","fr":"Il réunit l’encre chinoise et la peinture occidentale : points, lignes et espaces blancs.","es":"Unió la tinta china y la pintura occidental: puntos, líneas y espacio en blanco."},{"en":"During the Cultural Revolution he was sent to a labour camp and forbidden to paint.","fr":"Pendant la Révolution culturelle, il est envoyé en camp de travail et interdit de peindre.","es":"Durante la Revolución Cultural lo enviaron a un campo de trabajo y le prohibieron pintar."}],"fact":{"en":"A strict judge of himself, he burned hundreds of paintings he wasn’t happy with, once some 200 in a single day.","fr":"Très sévère envers lui-même, il a brûlé des centaines de tableaux dont il n’était pas satisfait, un jour environ 200 d’un coup.","es":"Muy severo consigo mismo, quemó cientos de cuadros que no le convencían; una vez, unos 200 en un solo día."},"eventID":null,"imageURL":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Kwai_Tsing_Theatre.jpg/960px-Kwai_Tsing_Theatre.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","imagePlace":"葵青劇院 Kwai Tsing Theatre, Hong Kong"},{"id":"lin-tianmiao","artist":"Lin Tianmiao","headline":{"en":"Wrapped in white thread","fr":"Enveloppé de fil blanc","es":"Envuelto en hilo blanco"},"lines":[{"en":"As a child in China, she helped her mother wind cotton thread into balls.","fr":"Enfant, en Chine, elle aide sa mère à enrouler le fil de coton en pelotes.","es":"De niña, en China, ayudaba a su madre a enrollar hilo de algodón en ovillos."},{"en":"She now wraps everyday tools and objects in white thread until they turn soft and ghostly.","fr":"Aujourd’hui, elle enveloppe outils et objets du quotidien de fil blanc jusqu’à les rendre doux et fantomatiques.","es":"Hoy envuelve herramientas y objetos cotidianos en hilo blanco hasta volverlos suaves y fantasmales."},{"en":"She often works with her husband, the video artist Wang Gongxin.","fr":"Elle travaille souvent avec son mari, le vidéaste Wang Gongxin.","es":"Trabaja a menudo con su marido, el videoartista Wang Gongxin."}],"fact":{"en":"Her first big work, The Proliferation of Thread Winding (1995), was a bed pierced by thousands of needles, each trailing a white thread to a ball on the floor. It was first shown in the couple’s Beijing flat.","fr":"Sa première grande œuvre, The Proliferation of Thread Winding (1995), est un lit percé de milliers d’aiguilles, chacune reliée par un fil blanc à une pelote au sol. Elle a d’abord été montrée dans l’appartement du couple à Pékin.","es":"Su primera gran obra, The Proliferation of Thread Winding (1995), es una cama atravesada por miles de agujas, cada una unida por un hilo blanco a un ovillo en el suelo. Se mostró primero en el piso de la pareja en Pekín."},"eventID":null,"imageURL":"https://www.mplus.org.hk/api/images/14517/width-1000|format-jpeg/","imagePlace":"M+, Hong Kong"},{"id":"fassianos","artist":"Alekos Fassianos","headline":{"en":"Greek myths on a bicycle","fr":"Des mythes grecs à vélo","es":"Mitos griegos en bicicleta"},"lines":[{"en":"He trained as a violinist before turning to painting in Athens and Paris.","fr":"Il étudie le violon avant de se tourner vers la peinture, à Athènes puis à Paris.","es":"Estudió violín antes de dedicarse a la pintura, en Atenas y en París."},{"en":"His figures look like gods from an ancient vase, but ride bicycles and smoke.","fr":"Ses personnages ressemblent aux dieux des vases antiques, mais roulent à vélo et fument.","es":"Sus figuras parecen dioses de un vaso antiguo, pero van en bicicleta y fuman."},{"en":"Flat colour, strong outlines, always in profile: modern Greece as a summer myth.","fr":"Aplats de couleur, contours forts, toujours de profil : la Grèce moderne comme un mythe d’été.","es":"Color plano, contornos fuertes, siempre de perfil: la Grecia moderna como un mito de verano."}],"fact":{"en":"He wrote poems and novels too, and designed sets and costumes for the theatre.","fr":"Il a aussi écrit des poèmes et des romans, et dessiné des décors et des costumes de théâtre.","es":"También escribió poemas y novelas, y diseñó decorados y vestuario para el teatro."},"eventID":null,"imageURL":"https://www.nationalgallery.gr/wp-content/uploads/2021/09/123.jpg","imagePlace":"The Athens Gallery, Athens"},{"id":"lepage","artist":"Robert Lepage","headline":{"en":"Theatre like a magic trick","fr":"Le théâtre comme un tour de magie","es":"El teatro como un truco de magia"},"lines":[{"en":"From Quebec City, he makes theatre where sets turn, fly and transform.","fr":"De Québec, il fait un théâtre où les décors tournent, volent et se transforment.","es":"Desde Quebec hace un teatro donde los decorados giran, vuelan y se transforman."},{"en":"A washing machine becomes a spaceship; a wall becomes a cinema screen.","fr":"Une machine à laver devient un vaisseau spatial ; un mur, un écran de cinéma.","es":"Una lavadora se vuelve una nave espacial; una pared, una pantalla de cine."},{"en":"He often plays every role himself in his solo shows.","fr":"Dans ses spectacles en solo, il joue souvent tous les rôles.","es":"En sus espectáculos en solitario suele interpretar todos los papeles."}],"fact":{"en":"For the Met’s Ring cycle he built a 45-tonne set of 24 tilting planks, nicknamed the Machine. The stage had to be reinforced to carry it.","fr":"Pour le Ring du Met, il construit un décor de 45 tonnes fait de 24 planches basculantes, surnommé la Machine. Il a fallu renforcer la scène.","es":"Para el Anillo del Met construyó un decorado de 45 toneladas con 24 tablones basculantes, apodado la Máquina. Hubo que reforzar el escenario."},"eventID":null,"imageURL":null,"imagePlace":null},{"id":"robert-wilson","artist":"Robert Wilson","headline":{"en":"Five hours of slow light","fr":"Cinq heures de lumière lente","es":"Cinco horas de luz lenta"},"lines":[{"en":"Born in Texas, he makes stage pictures that move very slowly, lit like paintings.","fr":"Né au Texas, il crée des tableaux scéniques qui bougent très lentement, éclairés comme des peintures.","es":"Nacido en Texas, crea cuadros escénicos que se mueven muy despacio, iluminados como pinturas."},{"en":"In 1976 he and Philip Glass made Einstein on the Beach, an opera with no story, almost five hours long.","fr":"En 1976, avec Philip Glass, il crée Einstein on the Beach, un opéra sans histoire de près de cinq heures.","es":"En 1976 creó con Philip Glass Einstein on the Beach, una ópera sin historia de casi cinco horas."},{"en":"The audience was invited to come and go as they liked.","fr":"Le public pouvait entrer et sortir à sa guise.","es":"El público podía entrar y salir cuando quisiera."}],"fact":{"en":"One of his early works, KA MOUNTAIN, was performed on a hilltop in Iran in 1972 and lasted seven days and nights.","fr":"L’une de ses premières œuvres, KA MOUNTAIN, a été jouée sur une colline en Iran en 1972 et a duré sept jours et sept nuits.","es":"Una de sus primeras obras, KA MOUNTAIN, se representó en una colina de Irán en 1972 y duró siete días y siete noches."},"eventID":null,"imageURL":null,"imagePlace":null}],"venues":[{"id":"osm-n82781680","name":"Cines Verdi Barcelona","kind":"cinema","address":"32 Carrer de Verdi","district":"","latitude":41.4040146,"longitude":2.1568811,"website":"https://www.cines-verdi.com/barcelona/","openingHours":null,"photoURL":"https://www.bizcochito.es/img/tt44766123-es-pos.webp","photoCredit":null,"wheelch